#!/bin/ksh
# doasq-queue.cgi — the web approval surface for the doasq queue.
# Served by OpenBSD httpd + slowcgi from the /var/www chroot, behind
# htpasswd authentication (the REMOTE_USER gate). Phone-friendly.
#
# Security model (borge/doasq.borg phase-2):
#   - the htpasswd credential is roerick's; hollis cannot authenticate
#   - approvals written here carry approved-by: roerick (via web)
#   - the sha discipline is unchanged: the approval covers the exact
#     command bytes; doasq-exec re-verifies at run time
#   - nothing runs at approval; execution stays doasq-exec-only

Q=/var/www/doasq
REQ="$Q/requests"
OK="$Q/approvals"
RUNS="$Q/runs"

die_html() {
  printf 'Content-Type: text/html\r\n\r\n'
  printf '<!doctype html><html><head><meta charset="utf-8">'
  printf '<meta name="viewport" content="width=device-width, initial-scale=1">'
  printf '<title>doasq</title></head><body style="font-family:sans-serif;max-width:52rem;margin:1rem auto;padding:0 1rem">'
  printf '<h1>doasq</h1><p style="color:#a32020"><b>%s</b></p>' "$1"
  printf '<p><a href="/cgi-bin/doasq-queue">back to the queue</a></p></body></html>'
  exit 1
}

html_head() {
  printf 'Content-Type: text/html\r\n\r\n'
  printf '<!doctype html><html><head><meta charset="utf-8">'
  printf '<meta name="viewport" content="width=device-width, initial-scale=1">'
  printf '<title>doasq — the approval queue</title></head>'
  printf '<body style="font-family:sans-serif;max-width:52rem;margin:1rem auto;padding:0 1rem">'
  printf '<h1>doasq — the approval queue</h1>'
  printf '<p style="color:#6b6458">authenticated as %s — every approval is attributed, sha-bound, and audited</p>' "$REMOTE_USER"
}

esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

# ---- POST actions (approve / reject) ----
if [ "${REQUEST_METHOD:-GET}" = "POST" ]; then
  read -r postdata
  action="" ; rid=""
  for pair in $(printf '%s' "$postdata" | tr '&' ' '); do
    k="${pair%%=*}" ; v="${pair#*=}"
    case "$k" in
      action) action="$v" ;;
      id) rid="$v" ;;
    esac
  done
  case "$rid" in *[!A-Za-z0-9_-]*|"") die_html "bad id" ;; esac
  [ "$(id -un)" = "www" ] || die_html "cgi must run as www"
  [ -f "$REQ/$rid.req" ] || die_html "no such request"
  case "$action" in
    approve)
      [ -f "$OK/$id.ok" ] && die_html "already approved"
      [ -f "$OK/$id.used" ] && die_html "already used (one-shot)"
      req_sha="$(sed -n 's/^sha256: //p' "$REQ/$id.req")"
      [ -n "$req_sha" ] || die_html "request has no sha"
      umask 077
      {
        print -r -- "approved-by: roerick (via web, $REMOTE_USER)"
        print -r -- "approved-at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        print -r -- "sha256: $req_sha"
      } > "$OK/$id.ok" || die_html "cannot write the approval (dir perms)"
      html_head
      printf '<h2>approved %s</h2>' "$rid"
      printf '<p>hollis runs: <code>doasq run %s</code></p>' "$rid"
      printf '<p><a href="/cgi-bin/doasq-queue">back</a></p></body></html>'
      ;;
    reject)
      umask 077
      print -r -- "rejected-by: roerick (via web)" > "$OK/$id.rejected" 2>/dev/null \
        || die_html "cannot write the rejection"
      html_head
      printf '<h2>rejected %s</h2><p><a href="/cgi-bin/doasq-queue">back</a></p></body></html>'
      ;;
    *) die_html "unknown action" ;;
  esac
  exit 0
fi

# ---- GET: the queue list, or one request ----
html_head

id=""
case "${QUERY_STRING:-}" in
  id=*[!A-Za-z0-9_-]*|"") id="" ;;
  id=*) id="${QUERY_STRING#id=}"; id="${id%%&*}" ;;
esac

if [ -n "$id" ]; then
  f="$REQ/$id.req"
  [ -f "$f" ] || die_html "no such request"
  print '<h2>request</h2><pre style="background:#ebe4d4;padding:.6rem;overflow-x:auto">'
  esc < "$f"
  print '</pre>'
  if [ -f "$OK/$id.used" ]; then
    print '<p style="color:#1f6b3a"><b>used</b> (one-shot consumed)</p>'
  elif [ -f "$OK/$id.ok" ]; then
    print '<p style="color:#1f6b3a"><b>APPROVED</b> — hollis can run it</p>'
  else
    print '<form method="post" action="/cgi-bin/doasq-queue">'
    printf '<input type="hidden" name="action" value="approve">'
    printf '<input type="hidden" name="id" value="%s">' "$id"
    printf '<p><button type="submit" style="font-size:1.2rem;padding:.6rem 1.4rem">APPROVE</button> '
    printf '<button type="submit" name="action" value="reject" style="padding:.6rem 1.4rem">reject</button></p></form>'
  fi
  print '<p><a href="/cgi-bin/doasq-queue">back to the queue</a></p></body></html>'
  exit 0
fi

print '<h2>pending</h2>'
found=0
for f in "$REQ"/*.req; do
  [ -f "$f" ] || continue
  found=1
  rid="$(basename "$f" .req)"
  who="$(sed -n 's/^requester: //p' "$f")"
  why="$(sed -n 's/^why: //p' "$f")"
  st="pending"
  [ -f "$OK/$rid.ok" ] && st="APPROVED"
  [ -f "$OK/$rid.used" ] && st="used"
  print -r -- "<p><a href=\"/cgi-bin/doasq-queue?id=$rid\"><b>$rid</b></a> — $st — by $who<br><span style=\"color:#6b6458\">$why</span></p>"
done
[ "$found" = 1 ] || print '<p><i>no requests</i></p>'
print '</body></html>'
