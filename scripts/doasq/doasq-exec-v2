#!/usr/bin/env python3
"""doasq-exec v2 — the habitat-native privileged-request runner.

Invoked via the single doas rule (permit nopass hollis cmd doasq-exec).
Reads APPROVED cards from the doasq-requests list through the habitat
API using hollis's DATA-ONLY token (the delegation model: the agent's
credential touches data; the execution is the root helper's job).

Per card: verify the sha recorded at submission still matches the
  command bytes (tamper = refuse); verify the card state is APPROVED and
  the transition was made by the configured approver (the event log);
  run via ksh -c; post the output as a card comment; move the card to
  DONE. One-shot by state: DONE cards are never re-run.

The audit = the card's event/comment trail + the activity ledger —
the house's native audit, not a bespoke log.
"""
import base64, datetime, hashlib, json, os, subprocess, sys, urllib.request

BASE = "https://pricklypear.rocks"
TOKEN = open("/home/hollis/secrets/ppdesignate").read().strip()
LIST_ID = open("/var/lib/doasq/list-id").read().strip() if __import__("os").path.exists("/var/lib/doasq/list-id") else "19eba8e4-87c8-48a8-b04f-4da6f499a180"
# The approver is configuration, not a hardcoded name:
# /var/lib/doasq/approver (one username — the event-log author whose
# APPROVED transitions the runner will honor). Default: roerick.
APPROVER = open("/var/lib/doasq/approver").read().strip() if __import__("os").path.exists("/var/lib/doasq/approver") else "roerick"

# The request log: one JSON line per doasq request the runner sends —
# timestamp, endpoint, payload, and doasq's reply (failed requests too,
# as the error). Card 606e4a17: no more silent requests. ./status.sh reads it.
LOG_PATH = os.environ.get(
    "DOASQ_LOG",
    os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(
        os.path.abspath(__file__)))), "logs", "loop.log"))

def log_request(endpoint, payload, response):
    rec = {"ts": datetime.datetime.now(datetime.timezone.utc)
                   .isoformat(timespec="seconds"),
           "endpoint": endpoint,
           "payload": payload,
           "response": response}
    line = "doasq request " + json.dumps(rec, sort_keys=True)
    try:
        d = os.path.dirname(LOG_PATH)
        if d:
            os.makedirs(d, exist_ok=True)
        with open(LOG_PATH, "a") as f:
            f.write(line + "\n")
    except OSError as e:
        print("doasq-exec: cannot log to %s: %s" % (LOG_PATH, e), file=sys.stderr)

def api(expr, timeout=120):
    endpoint = BASE + "/api/eval"
    body = json.dumps({"expr": expr})
    req = urllib.request.Request(endpoint, data=body.encode(),
        headers={"Content-Type": "application/json",
                 "Authorization": "Bearer " + TOKEN})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            raw = r.read().decode()
    except Exception as e:
        log_request(endpoint, body, {"error": str(e)})
        raise
    log_request(endpoint, body, raw[:2000])
    return json.loads(raw)

def die(msg):
    print("doasq-exec: " + msg, file=sys.stderr)
    sys.exit(1)

def sha_of(text):
    return hashlib.sha256(text.encode()).hexdigest()


def approved_by(events, approver):
    """The attribution check: author rides the event ROW METADATA
    (top-level "author" on the node-JSON), the transition rides the
    body (to_state). A substring scan of the whole event JSON would
    credit a mention of the name, not an authored approval."""
    return any(
        str((e.get("body") or {}).get("to_state", "")) == "APPROVED"
        and str(e.get("author", "")) == approver
        for e in events)

# -- gather the list's cards --
# The queue lives in the SHARED data space (data.s): a Board on ANY seat may
# hold the doasq-requests list and its cards. Scan the shared root at type
# depth — the same walk as the habitat face (doasq/items in
# libs/doasq/lib.pp) — instead of one hardcoded seat subtree, which
# silently dropped cards filed from other seats.
rows = api('(tree/list "data.s" 3 5000)').get("value", [])
list_row = next((r for r in rows
                 if r.get("type") == "todo-list"
                 and (r.get("body") or {}).get("title") == "doasq-requests"), None)
if list_row is not None:
    list_id = str(list_row["id"]).replace("-", "")  # path tail form
else:
    # fall back to the pinned list id (the bootstrap's config file)
    list_id = LIST_ID.replace("-", "")
items = [r for r in rows
         if r.get("type") == "todo-item"
         and str((r.get("body") or {}).get("list_id", "")).replace("-", "") == list_id]

approved = []
for it in items:
    b = it.get("body") or {}
    if str(b.get("state", "")) == "APPROVED":
        approved.append(it)

if not approved:
    print("doasq-exec: nothing APPROVED pending")
    sys.exit(0)

rc_all = 0
for it in approved:
    body = it.get("body") or {}
    iid = it["id"]
    title = str(body.get("title", "?"))[:70]
    notes = str(body.get("notes", ""))
    rec_sha = str(body.get("sha", ""))

    # 1. tamper check: the recorded sha must match the current command bytes
    if not rec_sha or sha_of(notes) != rec_sha:
        print(f"doasq-exec: SKIP {iid} — sha mismatch (the card was edited after approval)")
        api(f'(todo/db/update-field "todo-item" "{iid}" "state" "REJECTED")')
        rc_all = max(rc_all, 1)
        continue

    # 2. the transition to APPROVED must exist in the card's event log,
    #    authored by the configured approver (the attribution check)
    ev = api(f'(todo/event/list "{iid}")').get("value", [])
    if not approved_by(ev, APPROVER):
        print(f"doasq-exec: SKIP {iid} — no {APPROVER} approval transition in the event log")
        continue

    # 3. claim: state -> RUNNING (one-shot; a re-run sees RUNNING and skips)
    api(f'(todo/db/update-field "todo-item" "{iid}" "state" "RUNNING")')

    print(f"doasq-exec: running {iid} — {title}")
    print(f"  command: {notes[:200]}{'...' if len(notes) > 200 else ''}")
    proc = subprocess.run(["/bin/ksh", "-c", notes],
                          capture_output=True, text=True, timeout=1800)
    out = (proc.stdout + proc.stderr)[-8000:]

    # 4. the output = a card comment; the card -> DONE
    esc = out.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
    api(f'(todo/comment/add "{iid}" "EXECUTION rc={proc.returncode}\\n{esc}")')
    api(f'(todo/db/update-field "todo-item" "{iid}" "state" "DONE")')
    print(f"doasq-exec: {iid} rc={proc.returncode} (output posted as a card comment)")
    rc_all = max(rc_all, proc.returncode)

sys.exit(rc_all)
