#!/usr/bin/env python3
"""doasq v2 — the CLI filer for the habitat-native privileged-request queue.

submit  files a request card on the doasq-requests Board list: the
command text verbatim (stdin preferred — quoting exact), the sha covers
every byte, the why is the card title. The approval = roerick moves the
card to APPROVED in the kanban (his session, his gate). The execution =
the root helper (doasq-exec), run by hollis when he sees APPROVED.
"""
import hashlib, json, sys, urllib.request, uuid

BASE = "https://pricklypear.rocks"
TOKEN = open("/home/hollis/secrets/ppdesignate").read().strip()
LIST_ID = "19eba8e4-87c8-48a8-b04f-4da6f499a180"

def api(expr, timeout=90):
    req = urllib.request.Request(BASE + "/api/eval",
        data=json.dumps({"expr": expr}).encode(),
        headers={"Content-Type": "application/json",
                 "Authorization": "Bearer " + TOKEN})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode())

def die(msg):
    print("doasq: " + msg, file=sys.stderr)
    sys.exit(1)

args = sys.argv[1:]
cmd = args[0] if args else ""
if cmd == "submit":
    why = ""
    rest = args[1:]
    if rest and rest[0] == "-w":
        why = rest[1]; rest = rest[2:]
    if rest and rest[0] == "--":
        rest = rest[1:]
    if rest:
        text = " ".join(rest)
        print("note: argument mode flattens quoting — prefer stdin", file=sys.stderr)
    else:
        text = sys.stdin.read()
    text = text.strip()
    if not text:
        die("empty command")
    if not why:
        die("a plain-language -w why is required — the approver sees it first")
    iid = str(uuid.uuid4())
    sha = hashlib.sha256(text.encode()).hexdigest()
    title = why if len(why) <= 80 else why[:77] + "..."
    body = ('(list (cons "list_id" "%s") (cons "title" "%s") (cons "notes" %s) '
            '(cons "state" "SUBMITTED") (cons "due" "") (cons "done" "false") '
            '(cons "position" "0") (cons "kind" "DOASQ") (cons "pipeline" "") '
            '(cons "sha" "%s"))' % (LIST_ID, title.replace('"', ''),
                                    json.dumps(text), sha))
    tail = iid.replace("-", "")
    d = api('(tree/upsert "data.s.Ym9hcmQ1.dG9kby1pdGVt0.%s" "datum" "todo-item" %s)' % (tail, body))
    if not d.get("ok"):
        die("submit failed: " + str(d)[:200])
    print("filed %s" % iid)
    print("  why:  " + why)
    print("  next: roerick moves the card to APPROVED in the kanban (the doasq-requests list)")
    print("  then: hollis runs doasq-exec")
elif cmd == "list":
    print("the queue lives in the kanban: /kanban — the doasq-requests list")
    print("(the card states are the queue state; the kanban is the surface)")
elif cmd in ("show", "approve", "run", "log"):
    die("v2: show/approve/run live in the kanban UI and doasq-exec — the CLI files only")
else:
    print(__doc__)
    sys.exit(2)
