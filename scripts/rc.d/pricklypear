#!/bin/ksh
# /etc/rc.d/pricklypear — single Pricklypear image service.
#
# One process. No supervisor, no authd (retired by the single-image pivot).
# The image binary serves htmx HTTP + a line-protocol REPL directly.

daemon="/usr/local/libexec/pricklypear/current/bin/run-image.ksh"
daemon_user="_pricklypear"
daemon_class=daemon
daemon_timeout=30
rc_bg=YES

service_name="pricklypear"
env_file="${PP_ENV_FILE:-/etc/pricklypear/pricklypear.env}"
runtime_dir="${PP_RUNTIME_DIR:-/var/run/pricklypear}"
pidfile="${PP_IMAGE_PIDFILE:-${runtime_dir}/image.pid}"
log_dir="${PP_LOG_DIR:-/var/log/pricklypear}"

if [ -f "${env_file}" ]; then
	set -a
	# shellcheck disable=SC1090
	. "${env_file}"
	set +a
fi

. /etc/rc.d/rc.subr

rc_pre() {
	install -d -o "${daemon_user}" -g "${daemon_user}" -m 0750 \
		"${runtime_dir}" "${log_dir}"
}

rc_check() {
	# Health probe is the ONLY liveness signal (require ok:true, not mere
	# "ok" — ok:false must fail so a live-but-DB-dead image is restarted).
	# Deliberately NOT pidfile+kill -0 first: after any overlapping
	# start/stop (promote window, watchdog, manual), an orphan may hold
	# :18080 and serve healthily while the pidfile points at a dead
	# EADDRINUSE child — pidfile checks turned that into a restart loop
	# on 2026-08-21. A healthy listener IS a healthy service; rc_stop's
	# belt already culls strays during intentional restarts.
	port="${PP_HTTP_PORT:-18080}"
	body="$(ftp -o - "http://127.0.0.1:${port}/health" 2>/dev/null)" || return 1
	print -r -- "${body}" | grep -q '"ok"[[:space:]]*:[[:space:]]*true' || return 1
}

# Drop any leftover image listener before start/restart. A poisoned process
# can hold :18080 after pidfile loss; plain start then fails EADDRINUSE.
rc_stop() {
	if [ -f "${pidfile}" ]; then
		pid="$(cat "${pidfile}" 2>/dev/null)" || true
		if [ -n "${pid}" ]; then
			kill "${pid}" 2>/dev/null || true
			sleep 1
			kill -0 "${pid}" 2>/dev/null && kill -KILL "${pid}" 2>/dev/null || true
		fi
	fi
	# Belt: any leftover runtime-user image binary on this host.
	pkill -U "${daemon_user}" -f '/bin/image' 2>/dev/null || true
	sleep 1
	rm -f "${pidfile}" 2>/dev/null || true
	return 0
}

rc_post() {
	rm -f "${pidfile}" 2>/dev/null || true
}

rc_cmd "$1"
