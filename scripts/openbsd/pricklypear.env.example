# /etc/pricklypear/pricklypear.env — runtime config (OpenBSD)
# Install as mode 640 root:_pricklypear. Sourced by rc.d / run-image.ksh.
#
# Single-image model: one process. No supervisor, no authd.

# Postgres (TCP to local cluster)
PP_DB_HOST=127.0.0.1
PP_DB_PORT=5432
PP_DB_NAME=pricklypear
PP_DB_USER=pricklypear
PP_DB_PASS='CHANGE_ME'

# Image identity (REPL / boot defaults; HTTP identity comes from login)
PP_USERNAME=admin
PP_BRANCH_NAME=main
PP_BRANCH_ID=00000000-0000-0000-0000-000000000001

# Multi-user auth (in-image): bootstrap first admin + password when users empty
# or when admin has no password credential yet. Change after first login.
PP_BOOTSTRAP_USER=admin
PP_BOOTSTRAP_PASSWORD='CHANGE_ME_BOOTSTRAP'
# PP_AUTH_DISABLED=1   # dev only — skip HTTP login gate

# Public route effect allowlist (capability-enforcement):
# default is pure|read-db|html|txn (no write-db/branch/ai/publish).
# Enable write-db on public handlers (signup, public capture):
# PP_PUBLIC_ALLOW_WRITE=1
# Prefer (with-public-write …) inside those handlers for the write body.

# Ports (image serves HTTP + a line-protocol REPL)
PP_HTTP_PORT=18080
PP_REPL_PORT=17878

# Image binary path (promote rewrites this)
PP_IMAGE_BIN=/usr/local/libexec/pricklypear/current/bin/image
PP_LIBS_DIR=/usr/local/libexec/pricklypear/current/libs
# Public release face (landing /code /book.pdf /src.tgz)
PP_SOURCE_ROOT=/usr/local/libexec/pricklypear/current/src
PP_STATIC_DIR=/usr/local/libexec/pricklypear/current/static
PP_PUBLIC_DIR=/usr/local/libexec/pricklypear/current/public

# Optional LLM
# LLM_API_BASE=https://api.synthetic.new/openai/v1
# LLM_API_KEY=
# LLM_MODEL=hf:zai-org/GLM-4.7-Flash

PP_STATE_DIR=/var/db/pricklypear
PP_LOG_DIR=/var/log/pricklypear
