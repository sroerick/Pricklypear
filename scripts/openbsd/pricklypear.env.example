# /etc/pricklypear/pricklypear.env — runtime config (OpenBSD)
# Install as mode 640 root:_pricklypear. Sourced by rc.d / run-image.ksh.
#
# Single-image model: one process. No supervisor, no authd.

# Postgres (TCP to local cluster)
PP_DB_HOST=127.0.0.1
PP_DB_PORT=5432
PP_DB_NAME=pricklypear
PP_DB_USER=pricklypear
PP_DB_PASS='CHANGE_ME'

# Image identity (REPL / boot defaults; HTTP identity comes from login)
PP_USERNAME=admin
PP_BRANCH_NAME=main
PP_BRANCH_ID=00000000-0000-0000-0000-000000000001

# Multi-user auth (in-image): bootstrap first admin + password when users empty
# or when admin has no password credential yet. Change after first login.
PP_BOOTSTRAP_USER=admin
PP_BOOTSTRAP_PASSWORD='CHANGE_ME_BOOTSTRAP'
# PP_AUTH_DISABLED=1   # dev only — skip HTTP login gate

# Public route effect allowlist (capability-enforcement):
# default is pure|read-db|html|txn (no write-db/branch/ai/publish).
# Enable write-db on public handlers (signup, public capture):
# PP_PUBLIC_ALLOW_WRITE=1
# Prefer (with-public-write …) inside those handlers for the write body.

# Wall-clock timezone for the image process. The Nopales date prims
# (date-today / date-format / date-add-days / date-weekday) render in this
# zone; (now)/(now-ms) and ops/job-log formatting stay UTC regardless.
# Ops log pages and job-run timestamps are deliberately UTC (gmtime).
TZ=America/Denver

# Ports (image serves HTTP + a line-protocol REPL)
PP_HTTP_PORT=18080
PP_REPL_PORT=17878

# Per-user subdomains (auth.user-subdomains, card 57a8d68c): when set,
# https://<user>.<domain>/ serves that user's garden (classify_host →
# Host_garden), post_login redirects there, and the session cookie gains
# Domain=.<domain> + Secure (http_core.ml cookie_secure / set_cookie_header).
# Requires DNS wildcard *.pricklypear.rocks (already at Epik), an nginx
# wildcard server block (scripts/openbsd/nginx-subdomains.conf.example),
# and a wildcard TLS cert (LE DNS-01 — the zone is at ns3/ns4.epik.com;
# per-host HTTP-01 does not scale to usernames).
# promote.ksh carries this key into the live env ensure-if-missing from the
# example below; it never overwrites an operator-edited live value. To turn
# subdomains off, remove the line from BOTH the live env and this example.
PP_BASE_DOMAIN=pricklypear.rocks

# Image binary path (promote rewrites this)
PP_IMAGE_BIN=/usr/local/libexec/pricklypear/current/bin/image
PP_LIBS_DIR=/usr/local/libexec/pricklypear/current/libs
# Public release face (landing /code /book.pdf /src.tgz)
PP_SOURCE_ROOT=/usr/local/libexec/pricklypear/current/src
PP_STATIC_DIR=/usr/local/libexec/pricklypear/current/static
PP_PUBLIC_DIR=/usr/local/libexec/pricklypear/current/public

# Optional LLM
# LLM_API_BASE=https://api.synthetic.new/openai/v1
# LLM_API_KEY=
# LLM_MODEL=hf:zai-org/GLM-4.7-Flash

# LLM key envelope (i-1788670058): 64-hex used directly as the AES-256-GCM
# master key; any other secret is SHA-256-stretched. Unset = degraded mode:
# llm_key rows store PLAINTEXT with a loud boot/write warning. Once set,
# boot re-seals legacy plaintext rows idempotently — keep this stable;
# losing it means re-entering provider keys.
# PP_LLM_ENVELOPE_KEY=

PP_STATE_DIR=/var/db/pricklypear
PP_LOG_DIR=/var/log/pricklypear
# --- glochid shared harness (sourced by /etc/rc.d/glochid) ---
# The image home flip: once the glochid service runs and nginx routes a
# path to it, set PP_HOME_URL so the authenticated / lands on the
# glochid surface. Empty keeps /filmstrip.
# PP_HOME_URL lives in the SAME env file: the deployed example becomes
# /etc/pricklypear/pricklybear.env, already sourced by the image rc.d,
# so the image picks it up at its next restart with no extra wiring.

# Harness dial (blank = configure via the settings POST on the surface).
GLOCHID_PORT=18093
GLOCHID_API_KEY=
GLOCHID_BASE_URL=
GLOCHID_MODEL=
