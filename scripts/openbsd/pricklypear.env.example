# /etc/pricklypear/pricklypear.env — runtime config (OpenBSD)
# Install as mode 640 root:_pricklypear. Sourced by rc.d / run wrappers.
# Variable names match the OCaml code (PP_DB_*, PP_AUTH_PORT, PP_ADMIN_PORT).

# Quote any value with spaces. The env file is sourced by ksh.

# Postgres (TCP to local cluster)
PP_DB_HOST=127.0.0.1
PP_DB_PORT=5432
PP_DB_NAME=pricklypear

# Supervisor + image use the app role (DB owner)
PP_DB_USER=pricklypear
PP_DB_PASS='CHANGE_ME'

# Authd uses the restricted auth role (set only in authd wrapper)
PP_AUTH_DB_USER=pricklypear_auth
PP_AUTH_DB_PASS='CHANGE_ME_AUTH'

# Ports
PP_AUTH_PORT=17879
PP_ADMIN_PORT=17880
PP_SSH_PORT=17822
# PP_AWA_SSH_PORT=12223
PP_SSH_BIND=0.0.0.0

# Image binary path (promote rewrites this)
PP_IMAGE_BIN=/usr/local/libexec/pricklypear/current/bin/image

# First-boot admin (OpenSSH one-line pubkey). Quote required.
# PP_BOOTSTRAP_ADMIN_KEY='ssh-ed25519 AAAA... comment'

# Optional LLM
# LLM_API_BASE=https://api.synthetic.new/openai/v1
# LLM_API_KEY=
# LLM_MODEL=hf:zai-org/GLM-4.7-Flash

PP_STATE_DIR=/var/db/pricklypear
PP_LOG_DIR=/var/log/pricklypear
