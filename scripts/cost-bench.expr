(seq
  ;; Wire cost battery for the weekly profiler (card 99979a7a, pp/4).
  ;; bench returns mean microseconds per iteration. n is small for DB
  ;; reads (each iteration is ~0.6s); large for pure prims.
  (load-library "todo")
  (load-library "kanban")
  (load-library "notes")
  (define leval "d36355e1-5270-4a1d-9bf4-4aa68628895e")
  (define r
    (lambda (label src n)
      (string-append label "=" (as-str (bench src n)))))
  (string-append
    (r "floor(+ 1 1)" "(+ 1 1)" 2000)
    " | "
    (r "str(string-append x3)" "(string-append \"a\" \"b\" \"c\")" 2000)
    " | "
    (r "board(todo/all-items)" "(todo/all-items)" 3)
    " | "
    (r "list(todo/items-for-list eval)"
       "(todo/items-for-list \"d36355e1-5270-4a1d-9bf4-4aa68628895e\")" 3)
    " | "
    (r "lib(kanban/cards-in SPEC)"
       "(kanban/cards-in \"d36355e1-5270-4a1d-9bf4-4aa68628895e\" \"SPEC\")" 3)
    " | "
    (r "notes(notes/all-todos)" "(notes/all-todos)" 2)))
