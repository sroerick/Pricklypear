  (subsection vocabulary
   (doc "Friendly UI labels over systems jargon")
   (status implemented)
   (* agent note (|it32: IMPLEMENTED. Nav/home/pages use Functions,
     Pages, Data, Workspace. Lisp prim names unchanged. Smoke checks
     home vocabulary.|) *)
   (verify
    (smoke "nav/home use Functions (not only Bindings) and point to /about"))
   (details
    (doc (|
         UI vocabulary (human):
           Functions  <- function_defs / bindings
           Pages      <- view_bindings / routes
           Data       <- type_defs + data_rows
           Workspace  <- current branch + whoami
           About      <- concepts guide

         Lisp/REPL vocabulary stays technical (define, route,
         deftype, rows). The browser skin translates.
    |))
   )
  )
  (subsection first-run-recipe
   (doc "One-click or one-form 'make a hello page' onboarding")
   (status implemented)
