  (subsection horizon
   (doc "Long-term possible futures built on this substrate (design only)")
   (status planned)
   (* agent note (|it32: design-only. Migrated from
     docs/concepts-and-horizon.md. Not an implementation checklist;
     guides prioritization and pitching.|) *)
   (details
    (doc (|
         Possible futures (not commitments):

         A. Personal computing environment
            Always-on personal image; notes/CRM/automations
            as live functions; browser as desktop.

         B. Multi-user community OS
            system/main commons; personal garden branches;
            merge reviews; author-runs-as-author capabilities.

         C. AI-native software workshop
            AI cohabits image; proposes types+fns+routes as
            app sketches; binding-level diffs; provenance;
            later addressable AST patches.

         D. Internal tools platform
            Team branches; shared business objects; live
            inspectable tools without redeploy for Lisp-tier
            changes.

         E. Education / research lab
            Legible multi-user systems + PL teaching with
            forks/merges and visible isolation.

         F. End-user programmable products
            Friendly skin on same substrate; templates as
            starter branches; AI drafts, users edit.

         G. Hardened multi-tenant service
            Solo5, real SSH + web login, argon2, mTLS,
            fleet policies, true setuid data scoping.

         Milestone ladder:
           now   — hacker env (define/edit/route/AI propose)
           next  — legibility (vocabulary, about, hello recipe,
                   browser login)
           later — environment feel (system browser density,
                   merge UI, permissions)
           horizon — community + AI coworker + Solo5 product

         Principles to preserve:
           live system over file tree; store is truth;
           code branches / data shared; functions compose;
           AI is an author not god mode; inspectability;
           isolation by process.
    |))
   )
  )
 )
 (section migrations
  (doc "Schema evolution: supervisor-applied, additive-only, schema authority in main")
  (* agent note (|plan-pass #4 (it20): migrations shipped. supervisor/lib/store.ml's migration runner (Run_pending_migrations + split_sql_statements) applies 001_branches.sql + 002_auth.sql + 003_data.sql idempotently tracked via schema_migrations table, blocking image boot until applied (verified it4 supervisor smoke test + it5 auth smoke test + it6 e2e). Spec-consistent: 11 tables across 3 migrations, all additive. The type_defs-merged-to-main -> emitted-DDL migration (the second ordering paragraph in applied-by-supervisor's doc text) is NOT yet built — v1 uses a single generic data_rows table for all user-declared types (migration 003), sidestepping the per-type-DDL emission machinery. That sub-feature is what keeps this section at `partial` rather than `implemented`. See BORGE-1783433175 for the comprehensive plan-pass rationale.|) *)
  (status partial)
  (verify
   (build "dune build supervisor")
   (build "psql ... — SELECT count(*) FROM schema_migrations expects 3")
   (smoke "/tmp/pp_e2e_it6.py — supervisor runs migrations on boot before serving image-boot requests"))
  (subsection applied-by-supervisor
   (doc "Supervisor owns schema state before any image boots")
   (status partial)
   (* agent note (|it20: IMPLEMENTED — supervisor's Run_pending_migrations in supervisor/lib/store.ml creates schema_migrations if missing, reads applied versions, applies pending .sql files (001, 002, 003 declared statically) in order. Each migration is split via the hand-rolled split_sql_statements (handles single-quoted strings, dollar-quoted $$ blocks, -- comments — see BORGE-1783527733). Idempotent: re-applying is a no-op (no duplicate schema_migrations rows). Verified end-to-end by /tmp/pp_e2e_it6.py through scripts/dev.sh. The NOT-yet-built half: migrations EMITTED FROM type_defs merged to main — v1 uses a single shared data_rows table (migration 003) instead of per-type-DDL emission, so the type-declaration -> DDL migration machinery doesn't exist.|) *)
   (details
    (doc (|
         The SUPERVISOR, not the image, runs migrations.
         It owns schema state because it owns image
         lifecycle. Images assume "the schema is current".

         Migration source: SQL files in migrations/
         (version-numbered), PLUS migrations emitted from
         type_defs that have been merged to main (the
         type-declaration -> DDL emission).

         Initial migrations:
           001_branches.sql  — code store tables
             (branches, function_defs, type_defs,
             view_bindings, sessions, schema_migrations)
           002_auth.sql      — auth tables
             (users, credentials, sessions
              [NAMED auth_sessions to avoid clash],
              auth_log, system_keys)
             + CREATE ROLE pricklypear_auth with
             SELECT-only on its own tables;
             system_keys GRANTed ONLY to that role.
             The supervisor runs the migration but never
             connects as pricklypear_auth; only the auth
             image does.

         Applied idempotently: tracked in schema_migrations
         table. On supervisor boot:
           1. Read applied versions from schema_migrations.
           2. Apply any pending migrations in order.
           3. Only then: start serving image-boot requests.

         A migration in flight blocks new image boots until
         it completes (or fails). This guarantees images
         always see a consistent schema.

         Migration failure: supervisor refuses to boot
         images, alerts admin, requires manual intervention.
         No half-applied state. (Additive-only policy makes
         failure recovery simpler.)
   |))
   )
  )
  (subsection additive-only
   (doc "Schema changes can ADD, not remove or rename")
   (status implemented)
   (* agent note (|it20: IMPLEMENTED by policy — all 3 migrations (001_branches.sql, 002_auth.sql, 003_data.sql) are strictly additive: CREATE TABLE statements only, no DROP COLUMN, no RENAME, no ALTER COLUMN TYPE except column additions with sensible defaults. Migration 002 added DEFAULT gen_random_uuid() on all id columns during the it5 fix. No non-additive migrations exist in migrations/. The runtime type_defs -> data_rows story (v1: a shared generic table holds all user-declared types as JSONB) is itself additive — new types add rows, not DDL. (See BORGE-1783432745.)|) *)
   (verify
    (build "grep -rE 'DROP|RENAME|ALTER COLUMN TYPE' migrations/ = 0 matches")
    (smoke "all 3 migrations idempotently re-appliable"))
   (details
    (doc (|
         Schema evolution policy for type_defs in main:
         ADDITIVE ONLY. You can:
           - Add a new type (new table)
           - Add a new field to an existing type
             (ALTER TABLE ADD COLUMN, with NOT NULL
             forbidden unless a DEFAULT is specified)

         You CANNOT:
           - Remove a field (no DROP COLUMN)
           - Rename a field (no RENAME)
           - Change a field's type (no ALTER COLUMN TYPE
             except widening)

         WHY:
         - Additive changes are backward-compatible with
           running images. An image running old code that
           doesn't know about a new field still works; it
           just ignores the column.
         - Removing/renaming breaks running images that
           reference the field, with no compile-time error
           to catch it (Lisp is dynamic).
         - The cost is cruft accumulation: dead fields
           pile up over time. Tradeoff accepted for
           correctness.

         When a field truly must go: a manual migration
         (off-cycle, supervisor downtime, admin-run) that
         also updates affected branch code. This is rare
         and treated as an incident, not routine.

         This policy is set early because retrofitting it
         later (after non-additive migrations exist) is
         expensive. It is a foundation constraint.
   |))
   )
  )
  (subsection branching-interaction
   (doc "How migrations interact with branches")
   (status partial)
   (* agent note (|it31 plan-pass #7: corrected factual error in it20 note.
    IMPLEMENTED — migrations only touch shared data tables (data_rows has
    no branch_id; shared across branches per branching.data). A branch can
    propose a type change via (deftype ...); recursive-CTE lookup makes
    ancestor type_defs visible. schema_vers DOES exist on type_defs in
    migrations/001_branches.sql (integer NOT NULL DEFAULT 1, plus migrated
    boolean) — earlier notes wrongly claimed the column was missing.
    NOT IMPLEMENTED — runtime validation against schema_vers / main field
    set ("field X not in current main schema"), cache invalidation on
    schema change, and type_defs-merge-emitted DDL. v1 data_rows still
    accepts any jsonb fields bag for any type_name. schema_vers column is
    schema-ready; enforcement is the remaining partial.|) *)
   (details
    (doc (|
         Migrations only apply to the SHARED data tables
         (event, user, etc.), governed by main's type_defs
         (which are merge-governed into main).

         Branches CANNOT migrate data tables. A branch
         can PROPOSE a type change in its type_defs, but
         the underlying table doesn't change until that
         proposal is merged to main and the supervisor
         runs the resulting migration.

         A branch running code that references a field
         added in main but not yet handled by the branch's
         own code: works (the column exists; branch code
         ignores it on write, reads null on read if no
         default).

         A branch running code that references a field
         that DOESN'T exist (because the branch's type_defs
         is behind main's): runtime error at the primitive
         layer. The user gets a clear message: "field X
         not in current main schema; merge your schema
         change or sync to main".

         Schema version is tracked per type (schema_vers
         in type_defs). Branches see the version they
         declared; main sees its current version. The
         primitive layer can validate against either at
         query time.
   |))
   )
  )
 )
 (section workflow
  (doc "Build/test workflow and conventions")
  (status partial)
  (* agent note (|it31 plan-pass #7: conventions doctrinal text rewritten
    to the adopted v1 stack (Lwt, pgx_lwt+Io_unix, httpaf-lwt-unix,
    pure-html, own authd). build remains implemented. Section stays
    partial only while Solo5/prod-path conventions and any remaining
    package-layout drift are still open; day-to-day build workflow is
    green.|) *)
  (subsection build
   (doc "How to build and test each component")
   (status implemented)
   (* agent note (|The full build/test workflow described in this
     subsection's doctrinal text is exercised every iteration:
       - `dune build @all` exit 0 across all 5 packages (lisp, common,
         image, supervisor, auth) + the spikes/awa_ssh spike target.
       - `dune runtest --force` runs 92 alcotest cases (lisp 30 +
         common 10 + auth 4 + image 48).
       - `scripts/dev.sh start|stop|restart|status|clean` brings up
         the temp PG cluster (initdb if first run) + authd +
         supervisor, mirroring the "Full dev boot" path documented
         below (with PG + authd + supervisor in one command).
     Image/supervisor/ui binaries all run on mirage/unix per spec
     [architecture.mirage-vs-unix]; Solo5 still a deferred build
     switch. The 13 end-to-end smoke tests under /tmp/pp_*_it*.py
     exercise every layer end-to-end against the temp PG cluster at
     /tmp/pp-pgsup (port 5433).|) *)
   (details
    (doc (|
         Lisp interpreter (no services needed):
           cd lisp/ && dune build && dune runtest
           Tests are pure alcotest cases, no DB, no HTTP.

         Image (needs Postgres for full run, but builds
         without):
           cd image/ && dune build
           Run: dune exec bin/unikernel.ml (mirage/unix)
           Needs PG connection from env.

         Supervisor (needs Postgres for full run):
           cd supervisor/ && dune build
           Run: dune exec bin/supervisor.ml
           Needs PG connection, can boot images.

         Common:
           cd common/ && dune build && dune runtest

         Migrations:
           Applied by supervisor on boot, or manually via:
           psql -f migrations/NNN_xxx.sql

         Full dev boot:
           1. start Postgres
           2. dune exec supervisor/bin/supervisor.ml
              (supervisor runs migrations, then listens)
           3. ssh into a user's image
              (supervisor boots the image on connect)
   |))
   )
  )
  (subsection conventions
   (doc "Coding conventions for this project")
   (status partial)
   (* agent note (|it31 plan-pass #7: doctrinal text rewritten to adopted
     v1 stack. Deliberate choices now normative in the details below:
     Lwt (not Eio) in unikernels; pgx_lwt + custom Io_unix (not
     pgx_lwt_mirage in v1); httpaf-lwt-unix (httpaf-mirage does not
     exist on opam; future Solo5 path is gluten-mirage + httpaf);
     own authd unikernel (not wyo.auth) as the SSH/token/audit trust
     boundary. Eio remains allowed only for pure-unix dev tooling
     (lisp/bin/repl.ml, scripts). Section stays partial until Solo5
     package conventions and any remaining transport text elsewhere
     are fully aligned; the day-to-day v1 conventions are now honest.|) *)
   (details
    (doc (|
         v1 ADOPTED STACK (normative):
         - OCaml / dune (per poohstack); OCaml 5.x on the
           poohstack opam switch
         - Lwt for ALL unikernel I/O (supervisor, authd,
           image). Mirage's runtime is Lwt-based; the
           evaluator is Lwt-typed (eval returns value Lwt.t).
           Eio only for pure-unix dev tooling (e.g.
           lisp/bin/repl.ml), never inside unikernels.
         - pure-html (dream_html HTML core, no Dream) for
           HTML; use HTML.Hx.* not raw htmx attribute strings.
           txt ~raw:true for intentional raw-HTML injection.
         - httpaf-lwt-unix for image + supervisor + authd
           HTTP in v1. (There is no httpaf-mirage package on
           opam. Future Solo5 path: gluten-mirage + httpaf.)
         - Postgres via pgx_lwt + a custom Io_unix shim in v1
           (POSIX-flavored libs). pgx_lwt_mirage exists on the
           switch but needs a real Tcpip.Stack.V4V6 device,
           only available inside a true Mirage unikernel —
           that swap is a Solo5/v1.5 axis, not v1.
         - Auth via pricklypear's own authd unikernel (auth/),
           NOT wyo.auth. authd is the credential/token/audit
           trust boundary; supervisor calls it over internal
           HTTP RPC; images trust supervisor-asserted identity
           via the boot manifest.
         - SERIALIZABLE transactions by default for mutations
         - No ORM, no Postgres INHERITANCE, no premature
           abstraction; plain parameterized SQL
         - Additive-only schema migrations
         - The .borg file is the source of truth; if the
           implementation disagrees, the implementation is
           wrong — unless a plan pass rewrites the spec
         - Design changes go through borge plan/make/review;
           during make, file `borge issue new` instead of
           editing .borg

         DEFERRED CONVENTIONS (not v1-normative yet):
         - Solo5 target + Mirage-native transports
           (pgx_lwt_mirage, gluten-mirage, real VM boot)
         - mTLS/signed internal RPC between supervisor/authd
         - wyo.auth integration (explicitly not chosen for v1)
   |))
   )
  )
 )

 (section ai-authoring
  (doc "AI as a first-class author of functions: propose, surgical AST rewrite/freeze, growth-from-seed, human merge gate, provenance")
  (status partial)
  (* agent note (|it33: design expanded with growth-style coding tools
    (llm-inner/outer/seed) discussed with roerick. Still PARTIAL:
    blank-slate propose-function ships; surgical freeze rewrites and
    recursive seed growth are planned. Effects gates reference
    lisp-interpreter.effects. Runtime LLM-as-value holes are
    explicitly secondary to coding-tool freeze-on-accept.|) *)
  (verify
   (build "dune build @all")
   (smoke "AI propose on user branch -> human inspect -> merge policy gate")
   (smoke "future: llm-inner freeze rewrites stored AST; llm-seed grows outward on a branch"))
  (details
   (doc (|
        AI is an author, not a privileged runtime. Machine-
        written code uses the same store, branch, and merge
        machinery as human code. Default trust model:
        AI writes only to a user (or agent) branch; promoting
        into system/* still requires admin merge policy.

        Coding styles supported by the tool surface:

        1) Blank-slate propose
           (propose-function 'name "spec")
           Whole new/replaced binding from a prompt.

        2) Surgical freeze rewrite (CODING TOOL — preferred)
           (llm-inner 'name "concept")
           (llm-outer 'name "concept")
           LLM rewrites one AST component; on accept the
           result is FROZEN into function_defs (not left as
           an unevaluated hole). Emacs-ish replace-region
           with generated code, but tree-native.

        3) Growth-from-seed (CODING TOOL)
           (llm-seed "build an app that ...")
           Recursively: create smallest clean core, then
           llm-outer until requirements are satisfied.
           Bottom-up / inside-out Lisp style operationalized.

        4) Runtime generative eval (SECONDARY / later)
           Eval-time expansion of AI holes without freeze.
           Useful, but not the primary coding workflow.

        Non-goals for first cut of new tools:
        - AI does not bypass author-runs-as-author
        - AI does not write system/* without merge policy
        - full addressable node table not required for
          whole-function inner/outer (paths into JSONB AST
          suffice); node IDs are a later upgrade
          (branching.ast-nodes)
   |))
  )
  (subsection tools
   (doc "How an AI proposes or patches functions into the store")
   (status implemented)
   (* agent note (|it32: IMPLEMENTED blank-slate path. image/lib/
     llm_client.ml OpenAI-compat via curl; Session.propose_function;
     prim propose-function; POST /api/ai/propose; author agent:<model>.
     Surgical rewrite + seed growth live in sibling subsections.|) *)
   (verify
    (build "dune build image")
    (smoke "POST /api/ai/propose ai-double then (ai-double 21) => 42"))
   (details
    (doc (|
         v1 SHIPPED:
         - propose-function Lisp prim + /api/ai/propose
         - whole-function body from model, define on current branch
         - author = agent:<model>
         - never merges to system/*
         - local or remote OpenAI-compat endpoint via env
           LLM_API_BASE / LLM_API_KEY / LLM_MODEL

         Shared client contract for ALL AI tools:
         - non-streaming POST chat/completions (gateway-safe)
         - model returns code/AST only (no markdown essay)
         - parse gate before any store write
         - effect inference after parse (lisp-interpreter.effects)
         - policy gate before freeze

         Sibling tools (planned):
         - ast-rewrite: llm-inner / llm-outer / llm-rewrite
         - growth-seed: llm-seed recursive outer growth
    |))
   )
  )
  (subsection ast-rewrite
   (doc "Surgical coding tools: llm-inner / llm-outer / llm-rewrite with freeze-on-accept into stored AST")
   (status planned)
   (* agent note (|it33: NEW. Roerick's coding-tool model: not primarily
     runtime hole expansion; editor/session command that pings LLM to
     write one AST component, previews, freezes into function_defs.
     Emacs replace-region analogy. Depends on llm_client + AST
     json round-trip (already ship) + effects inference (planned).|) *)
   (verify
    (build "dune build image")
    (smoke "llm-inner on a binding rewrites body AST and survives reload")
    (smoke "llm-outer wraps a pure function; effect badges update")
    (smoke "reject unparseable model output without mutating store"))
   (details
    (doc (|
         PURPOSE
         Iterative code growth/refactor against live stored trees.
         Human (or command) supplies a concept; model rewrites ONE
         component; accept freezes into Postgres AST + live env.

         PRIMS / COMMANDS

         (llm-rewrite name prompt . options)
           General form. Options may include:
             mode: 'replace | 'wrap     ; default replace
             path: structural path      ; default whole body
             as: new-name               ; non-destructive rename target
             branch: branch-ref         ; work on a branch first
             accept: 'auto | 'preview   ; default preview in UI,
                                        ; REPL may auto with flag

         (llm-inner name prompt . options)
           Sugar: mode=replace on function body (or selection path).
           "Improve/replace the organ."

         (llm-outer name prompt . options)
           Sugar: mode=wrap on whole function.
           "Put tissue around the organ." Old behavior preserved
           via call-through or careful inline; prefer call-through
           to name-old or nested original subtree.

         FREEZE-ON-ACCEPT SEMANTICS (critical)
         1. Load current function AST from store/env
         2. Select target subtree (body / path / whole)
         3. Build surgical prompt (see PROMPT CONTRACT)
         4. Ping LLM local or remote
         5. Parse response as s-expr or JSON AST only
         6. Splice into tree (replace or wrap)
         7. infer_effects on result
         8. policy check (default allow Pure|ReadDb|Html;
            escalate WriteDb|Branch|Publish|Ai)
         9. Preview diff (pretty + optional AST)
         10. On accept:
             - persist function_defs.body JSONB
             - rebind live env
             - author = agent:<model>
             - optional provenance run id
         11. On reject: no store mutation

         This is NOT leaving (llm-inner ...) in the program.
         After accept, the program contains real Lisp AST only.

         PROMPT CONTRACT (surgical AST author)
         System:
           You are editing a Pricklypear Lisp AST.
           Return ONLY one replacement form: a single
           s-expression (or JSON AST). No markdown, no essay.
           You write ONE component of a larger program tree.

         User payload includes:
           - mode replace|wrap
           - function name
           - user concept / intent
           - current function pretty
           - current function AST json
           - selected path + selected subtree pretty/json
           - available prims summary
           - allowed effect set
           - for wrap: instruction to preserve behavior and
             call through original unless inlining is clearer

         Model output:
           - full lambda when replacing whole binding body
           - subtree only when replacing a selection hole
           - wrapper lambda when mode=wrap

         VALIDATION GATES
           - reader/json parse success
           - splice shape compatibility
           - effect policy
           - optional smoke eval of (name sample-args) if provided

         UI SURFACE
           - function editor command: Rewrite… / Wrap…
           - structural selection path when structure mode exists
           - REPL prims for power users
           - always show diff before freeze unless accept:'auto

         DEFAULTS (safety)
           - prefer work on current branch; offer agent/* branch
           - prefer preview over silent overwrite
           - keep old body in diff buffer / one-level undo
           - non-destructive 'as new-name always available

         NON-GOALS (this subsection)
           - recursive app growth (see growth-seed)
           - runtime hole expansion without freeze
           - multi-file repo patches
    |))
   )
  )
  (subsection growth-seed
   (doc "llm-seed: recursive bottom-up growth via smallest core + repeated llm-outer until requirements satisfied")
   (status planned)
   (* agent note (|it33: NEW. Roerick coding style operationalized:
     start from one little function, grow outward. llm-seed orchestrates
     propose/inner for the seed then recursive llm-outer with a planner
     prompt until the high-level requirement is met or caps hit.
     This is how LLMs can be made to work inside-out instead of only
     top-down whole-app dumps.|) *)
   (verify
    (build "dune build image")
    (smoke "llm-seed on a tiny goal produces >=1 frozen function on a branch")
    (smoke "growth stops at max-steps or requirement-satisfied judge")
    (smoke "each step is inspectable as a frozen binding + diff"))
   (details
    (doc (|
         PURPOSE
         Operationalize inside-out Lisp development for AI:
           seed a minimal clean function, then wrap/grow until
           the stated requirements are satisfied.

         TOP-LEVEL COMMAND

         (llm-seed requirement . options)

         Options (sketch):
           name: optional root name hint
           branch: default fork to user/ai-<stamp> or agent/*
           max-steps: default small (e.g. 4..8)
           budget: token/time caps
           effects-allow: default Pure|ReadDb|Html
           stop: 'ask | 'auto-judge

         ALGORITHM (orchestrator, not one giant prompt)

         Step 0 — Plan (optional short call)
           Given requirement, emit a growth outline:
             core behavior, successive wrappers, final page?
           Human may edit plan later; v1 can be implicit.

         Step 1 — Seed (smallest clean core)
           Prompt specialty:
             "Write the SMALLEST and CLEANEST pure-ish function
              that captures the essential nucleus of: <req>.
              One lambda only. No wrapping, no IO unless required."
           Freeze as seed name (e.g. notes-core).
           Run a tiny smoke if possible.

         Step 2..N — Grow outward (llm-outer loop)
           While not satisfied and steps < max-steps:
             a. Judge prompt (or human):
                "Does current function set satisfy <req>?
                 If not, what SINGLE outer responsibility
                 should be added next (validation, IO, page,
                 composition)?"
             b. If satisfied -> stop
             c. Else llm-outer on current tip with that single
                responsibility (surgical wrap prompt)
             d. Freeze wrapper as new tip (or replace tip name
                while keeping -vN history / old symbol)
             e. Record step in a growth log (session + optional
                data_rows type 'ai-growth-step)

         Step Final — Optional publish surface
           If requirement implies a page and effects allow:
             define page handler + (route ...)
           Still no auto-merge to system/*.

         JUDGE / STOP CONDITIONS
           - model judge returns satisfied=true
           - human stops
           - max-steps reached
           - effect escalation would exceed allowlist
           - parse/policy failures exceed retry budget

         WHY RECURSIVE OUTER NOT ONE-SHOT APP DUMP
           - preserves a working center at every step
           - each layer is runnable/testable in the image
           - matches bottom-up Lisp craft
           - forces LLMs into step-sized commits
           - diffs remain reviewable

         PROMPT SPECIALIZATIONS
           Seed prompt: smallest nucleus, prefer Pure
           Outer prompt: one responsibility only, preserve
             prior behavior via call-through
           Judge prompt: boolean satisfied + next missing
             capability in one short structured response

         FAILURE MODES / GUARDRAILS
           - onion wraps forever -> max-steps + dedupe judge
           - outer reimplements instead of wraps -> prompt
             + validation heuristic (must reference prior name)
           - effect creep -> policy gate per step
           - nondeterminism -> provenance + branch + growth log

         RELATIONSHIP TO OTHER TOOLS
           llm-seed USES:
             - blank-slate propose or llm-inner for seed
             - llm-outer for each growth ring
             - effects inference/policy each freeze
             - review-merge for promotion to system/*
           llm-seed is an orchestrator over ast-rewrite.

         NON-GOALS
           - fully autonomous unattended product engineering
           - hidden multi-minute agent swarms without logs
           - replacing human taste for when to re-inner/
             collapse wrappers after growth
    |))
   )
  )
  (subsection review-merge
   (doc "Human gate: inspect AI changes, then merge with existing policy")
   (status planned)
   (* agent note (|it33: still planned. Applies to propose, ast-rewrite
     freezes, and growth-seed branches alike. Growth log should appear
     in review UI when seed exists.|) *)
   (details
    (doc (|
         Review loop:
         1. AI commits one or more function_defs on a branch
            (propose, llm-inner/outer freezes, or llm-seed steps)
         2. Human opens system browser / functions list /
            editor / inspect to read AST + effect badges
         3. Human runs/tests via browser-repl or scripts/repl.sh
         4. For growth-seed: step through growth log diffs
         5. Human merges branch -> target via existing
            (merge ...) policy (admin-only into system/*)
         6. Reject path: leave branch, redefine, or undo freeze

         No separate "AI merge" privilege. Merge politics
         stay in branching.merge.
    |))
   )
  )
  (subsection provenance
   (doc "Attribution, audit, and trust labels for machine-authored code")
   (status partial)
   (* agent note (|it32/it33: PARTIAL. author=agent:<model> on propose.
     ast-rewrite/growth-seed must record the same plus optional run id
     and parent step for seed rings.|) *)
   (details
    (doc (|
         v1 SHIPPED: author=agent:<model> on AI writes; visible in
         /bindings and inspect.

         REQUIRED for rewrite/seed tools:
         - author agent:<model> on every freeze
         - optional metadata: run_id, parent_function,
           growth_step, prompt_hash, mode inner|outer|seed
         - growth-seed writes an inspectable step log

         DEFERRED: visual agent badge styling, dedicated audit table.
         Trust rule remains branch + merge policy + effect allowlists.
    |))
   )
  )
 )
)
