(project pricklypear-branching
 (doc "Pricklypear book chapter: branching")
 (status partial)
 (convention ocaml-dune)
 (section branching
  (doc "Branches as the fundamental organizational primitive: code branches, shared data, fork/merge")
  (status partial)
  (* agent note (|Section overall `partial` as of personal-workspace plan:
    fork = implemented, merge = partial, schema-authority = partial,
    personal-workspace = implemented (boot + seed-on-main),
    package-updates / promote / branch-browser-ui = planned.
    Per-subsection status below carries the per-feature detail.|) *)
  (details
   (doc (|
        Branches are to Pricklypear what files are to
        Unix: the fundamental organizational primitive.
        Everything is a branch; everything else is built
        on top of that.

        STORAGE (one Postgres, not one DB per branch):
        - branches(id, parent_id, owner, name, ...)
        - function_defs / type_defs / view_bindings
          each keyed by (branch_id, name|route)
        - data_rows has NO branch_id — shared data
        No separate schemas/tables per branch. No
        Postgres INHERITS (see storage.no-inheritance).

        KEY DISTINCTION: branches are for CODE, not data.
        - BRANCHED: function definitions, type schemas,
          view/route bindings.
        - SHARED: data_rows (todos, notes, bible, …).
          Alice's experimental branch renders against
          REAL shared data. She forks code, not data.

        TWO FORK SHAPES:
        - EMPTY child (personal garden): parent pointer
          only; inheritance via recursive CTE. Main
          package updates stay visible unless overridden.
        - FULL fork (experiment): copy code-rows from
          parent (cheap snapshot). Parent updates do not
          appear until merge.

        ROLES:
          system/main     package defaults (vendor channel)
          <user>/personal garden (user channel; boot default)
          <user>/<name>   experiments (full fork)

        Effective definition lookup (CLOS override):
        walk parent chain, closest definition wins.
        Writes (define/route) always hit the ACTIVE
        branch only.
   |))
  )
  (subsection ast-nodes
   (doc "Design: addressable AST nodes as substrate for surgical edits and AI patches")
   (status planned)
   (* agent note (|it31 plan-pass #7: NEW planned design subsection,
     elevating BORGE-1783398327 out of bugs-only limbo. Not required
     for v1 product cut (whole-function define/edit/AI propose is
     enough). Captures the 'nodes as substrate, named branchable
     subtrees as versioning unit' proposal so future plan/make work
     has a home. No schema migration until explicitly planned.|) *)
   (details
    (doc (|
         TODAY: two trees, two models
         - Branch tree: rows in branches, fork/merge,
           recursive CTE lookup, unit = whole function
         - AST tree: JSONB blob in function_defs.body,
           in-memory eval walk, no node ids, edit =
           replace whole body

         PROPOSAL (design only):
         Give AST nodes identity so AI/human tools can
         patch subexpressions without rewriting whole
         functions, while keeping branches as the
         versioning model over named subtrees.

         Sketch (non-normative until a later plan pass):
           nodes(id, branch_id, kind, payload, parent_id,
                 position, ...)
         function_defs may become a view/root pointer
         over a node tree, or remain a cache of the
         root expression.

         Non-goals for first product cut:
         - Do not block function-editor or ai-authoring
           tools on this redesign
         - Whole-function propose/edit ships first
    |))
   )
  )
  (subsection fork
   (doc "Forking a branch")
   (status implemented)
   (* agent note (|Implementation it9 (2026-07-06); hardened with a
     SERIALIZABLE transaction in it16. The 3-step implementation
     matches the spec text below exactly: INSERT branches row,
     INSERT function_defs copy, INSERT type_defs copy, INSERT
     view_bindings copy. All 4 statements run in a single
     `Store.with_transaction` (it16) — atomic, pgx-rolled-back on
     exception. The primitive is a normal Lwt-typed prim registered
     via `register_session_control_prims` (it12); its return value
     is the new branch UUID. Smoke test `/tmp/pp_fork_it9.py` exercises
     the full lifecycle; `/tmp/pp_override_it9.py` exercises the
     branch isolation half of fork semantics.|) *)
   (details
    (doc (|
         (fork 'main 'alice/experiment)

         Implementation:
         1. INSERT INTO branches (id, parent_id, owner,
            name, ...) VALUES (new_uuid, main_id, 'alice',
            'experiment', ...)
         2. INSERT INTO function_defs (branch_id, name,
            body, author, updated_at)
            SELECT new_uuid, name, body, author,
            updated_at FROM function_defs
            WHERE branch_id = parent_id
         3. Similarly for type_defs, view_bindings

         Cost: O(num code rows in parent). For ~100 fns
         and ~20 types, a few hundred row inserts. Lands
         in well under a second.

         Forking does NOT copy data table rows. The
         forked branch's functions operate on the same
         shared event rows as the parent.
   |))
   )
   (verify
    (test "image/test/primitives_test.ml — 48 alcotest cases")
    (build "dune build @all")
    (smoke "/tmp/pp_fork_it9.py — fork creates + copies function_defs")
    (smoke "/tmp/pp_override_it9.py — override-walk + branch isolation"))
  )
  (subsection merge
   (doc "Merging a branch into its parent")
   (status partial)
   (* agent note (|Implementation it10 (2026-07-06); hardened with a
     SERIALIZABLE transaction in it16. The current implementation
     does the basic case: INSERT INTO function_defs SELECT ... FROM
     function_defs WHERE branch_id=source ON CONFLICT (branch_id,
     name) DO UPDATE — full-source-to-target upsert of function_defs.
     Returns `merged N rows` count via INSERT RETURNING.
     Policy enforced at the Lisp prim layer (session.ml):
     admin-only merges TO system branches (owner="system"),
     per-user can merge into their own branches freely. Verified
     end-to-end by /tmp/pp_merge_it10.py (both happy-path and
     policy-rejection).

     NOT YET IMPLEMENTED (deferred — these are nicer-to-haves over
     the basic merge):
     (1) diff-based merge (only fns whose updated_at > parent's
         last_synced_with_child, OR whose name was added in child).
     (2) per-function conflict detection (parent ALSO modified same
         name since fork → conflict surfacing).
     (3) type_defs schema-merge governance (only main accepts
         schema changes via migration-governed merge).
     (4) the real htmx inspector UI for per-function conflict
         resolution.

     Section marked `partial` until at least (1) and (2) land; (3)
     and (4) are explicitly v2+ features.|) *)
   (details
    (doc (|
         (merge 'alice/experiment 'alice/main)

         Policy:
         - Default: admin-only merges to main,
           per-user can merge into their own branches
           freely.
         - Expandable later (PR/review flow).

         Implementation:
         1. Compute diff: code rows in alice/experiment
            whose updated_at > parent's last_sync_with_child,
            OR whose name was added in child.
         2. For each changed function, apply to parent.
            Conflict if parent ALSO modified same name
            since fork. Per-function conflict (coarse, not
            line-level): pick a version, or write a new one.
         3. Schema changes (type_defs) are merge-governed
            separately: only main accepts schema changes.
            A branch can propose; main accepts via a
            special merge that runs the migration.

         The merge needs a real htmx UI (in the inspector):
         list changed functions, show diffs (whole function
         bodies since functions are atomic units), let user
         resolve per-function.
   |))
   )
   (verify
    (test "image/test/primitives_test.ml — 48 alcotest cases")
    (build "dune build @all")
    (smoke "/tmp/pp_merge_it10.py — merge basic upsert + admin-only policy"))
  )
  (subsection schema-authority
   (doc "Types in main, branches read against main's schema")
   (status partial)
   (* agent note (|Partially implemented as of it14 (2026-07-06): the
     `(deftype 'name 'field1 ...)` prim lands type declarations into
     the `type_defs` table on the current branch; `Store.list_types`
     walks the recursive-CTE override chain so ancestor type
     declarations are visible to descendant branches (the read side
     of "branches read against main's schema"). The /types system page
     surfaces them in the UI.

     NOT YET IMPLEMENTED (deferred — explicitly v2+):
     (1) the migration-governed schema-change accept flow ("only
         main accepts schema changes via a special merge that runs
         the migration"). Currently any admin-author on the system
         branch can run (deftype ...) directly.
     (2) schema_version bump + cache-invalidation broadcast on
         schema change (LISTEN/NOTIFY or schema_version check).
     (3) governance policy for proposed-vs-accepted schema changes
         across non-system branches.

     The read side (recursive-CTE type lookup) IS implemented and
     spec-text-aligned. Marked `partial` until at least the
     migration-governed merge-to-main accept flow and the
     schema_version invalidation hook land.|) *)
   (details
    (doc (|
         Schema authority is 'main'. Branches CANNOT change
         the underlying table shape directly; they propose
         schema changes which only take effect when merged
         to main.

         When main accepts a schema change:
         1. Run migration on shared data table
            (additive-only: see migrations.additive-only)
         2. Bump schema_version
         3. All branches see new shape on next function
            lookup (cache invalidation: schema_version
            check, or LISTEN/NOTIFY)

         Branch code that ignores new fields: fine, reads
         subset. Branch code that expects old fields:
         errors at runtime (additive-only means removed
         fields don't happen, but renamed/reused-semantic
         fields could; document expectations).

         This makes type_defs the slow-changing,
         merge-governed layer; function_defs the
         fast-changing, per-branch layer. Two tiers of
         change, mirroring the OCaml-slow/Lisp-fast split.
   |))
   )
  )
  (subsection personal-workspace
   (doc "Boot on empty <user>/personal; seed package defaults only onto system/main")
   (status implemented)
   (* agent note (|Shipped a934445 / 42f755b: Store.ensure_branch creates
     EMPTY children; seed_stdlib uses Store.with_branch system/main;
     boot ensure_personal → seed main → checkout personal → rehydrate
     via Define AST (no pp_expr round-trip).|) *)
   (details
    (doc (|
         PROBLEM: reseeding libs/*.pp onto the active branch
         wiped live (define) edits after every deploy.

         MODEL:
         - system/main = package defaults (vendor channel).
           Boot seed_stdlib ALWAYS writes libs/*.pp here
           only (std, ui, ai, todo, bible, dabar today).
         - <user>/personal = garden (user channel).
           Empty child of system/main (parent pointer only).
           Image boots here after seed. User (define) and
           (route) write personal rows only.
         - Inheritance: recursive CTE; personal overrides
           shadow main; unpinned names auto-see main updates.

         BOOT ORDER:
         1. ensure_branch owner=username name=personal
            parent=system/main (no code copy)
         2. seed_stdlib with store.branch_id = system/main
         3. checkout personal + rehydrate env from CTE
         4. refresh ui/nav shell

         load-library on CURRENT branch still overwrites
         that branch (intentional). On personal that PINS
         the whole package — prefer small overrides.

         (checkout "system/main") / (checkout "admin/personal")
         rehydrate sync; header shows current branch.
    |))
   )
  )
  (subsection package-updates
   (doc "How software updates work: kernel vs main packages vs personal pins")
   (status planned)
   (details
    (doc (|
         THREE CHANNELS (not one monolithic version):

         1. KERNEL — OCaml binary (HTTP, prims, loader,
            chrome CSS). Updated by git push → promote →
            restart. No branch involved.

         2. PACKAGE DEFAULTS — function_defs on system/main
            from libs/*.pp. Updated by boot seed after deploy.
            Anyone who INHERITS a name (no personal row)
            gets the new body automatically.

         3. GARDEN PINS — function_defs rows on personal
            (or any child). Never written by seed. Survive
            every deploy. Shadow main until unoverride/merge.

         DATA (data_rows) is never versioned by branch and
         never wiped by push. New package code must tolerate
         older row shapes (defaults in readers) or ship an
         explicit data migrator.

         UPDATE RULE:
           inherited name  → auto-update on seed
           overridden name → user must accept (unoverride
                             or merge); show "main newer"

         CONSCIOUS UPDATE UX (planned on branch browser):
           per name: Use main's version | Keep mine | Diff
           per package: Reset package pins to main
           unoverride prim: delete personal row for name
             so inheritance resumes (MISSING today)

         load-library WARNING (planned): when current branch
         is not system/main, warn that loading pins the
         package on the garden.

         Anti-patterns:
           - reseed onto personal
           - auto-merge main→personal on boot
           - full copy-on-fork for personal (freezes forever)
           - treat data_rows as package payload
    |))
   )
  )
  (subsection promote
   (doc "Push garden work to system/main and/or git master (libs/*.pp)")
   (status planned)
   (details
    (doc (|
         Users will edit on personal and want to ship work
         upstream. Two destinations — both matter:

         A. LIVE main — (merge "admin/personal" "system/main")
            Upserts function_defs personal → main now.
            Admin-only into system/* (existing policy).
            NOT durable alone: next seed reloads libs/*.pp
            and can overwrite main unless git matches.

         B. GIT master — pp_sync pull <pkg> while on personal
            exports to libs/<pkg>/lib.pp; operator commits
            and git push wyo. Next seed makes main durable.

         FULL SHIP LOOP:
           edit on personal → dogfood
           → optional (merge personal main) for instant live
           → pp_sync pull selected packages
           → git commit + push
           → seed refreshes system/main from files
           → unoverride pins on personal so inheritance
             is clean (don't keep stale full-package pins)

         PROMOTE IS SELECTIVE:
           Ship package functions (ui/*, notes/*, …),
           NOT the entire garden (no personal-canary dump).
           UI: multi-select packages/names, then
             [ ] Merge into system/main
             [ ] Export for git (operator runs pp_sync/commit)

         Image does not git-push itself (no repo credentials
         in the image). Export API + laptop/habitat operator
         owns the commit.

         Policy:
           - merge to system/main: admin only
           - merge to own branches: free
           - data_rows never part of promote
    |))
   )
  )
  (subsection branch-browser-ui
   (doc "Git-like light /branches browser: list, open, stats, checkout, promote")
   (status planned)
   (implements image/lib/http.ml image/lib/store.ml image/lib/session.ml)
   (details
    (doc (|
         TODAY: GET /branches is a bare table
         (owner/name, parent uuid prefix, created).
         No checkout, stats, detail, or promote.

         GOAL: tiny Gitea-ish branch page in classic
         htmx chrome — browse, open, stats, checkout,
         later promote — no SPA.

         ROUTES:
           GET  /branches
           GET  /branches?ref=owner/name   detail
           POST /branches/checkout         ref=…
           POST /branches/fork             from + name
           POST /branches/merge            src + dst (later)
           POST /branches/promote          selective (later)

         LIST PAGE:
           Header strip: On: <current> ★ + quick links
           Table columns:
             ★ | branch | parent | own code |
             overrides | routes | age | actions
           own code = COUNT function_defs WHERE branch_id
             (no CTE). overrides = own names also on parent.
           actions: Open · Checkout (disabled if current)
           Labels: system/main "defaults"; */personal "garden"
           Create card: fork-from select + new name + Create
             (full fork for experiments; personal stays empty)

         DETAIL PAGE (?ref=):
           Title, parent link, Checkout, back to list
           Stats: own fns, overrides, own routes,
             visible fn count (CTE), last define, authors
           Sections (htmx partials):
             Overrides (default for personal) — name,
               author, updated, new|override, view, diff
             All own code
             Routes (own view_bindings)
             Activity: ORDER BY updated_at on own defs
               (revision log later)
           Diff vs parent v1: two <pre> columns of pp_expr
             (identical / changed / only-here / only-parent)

         CHECKOUT:
           POST → Session.checkout_to → 303 /branches
           or HX-Redirect. Defines already persisted; no
           "uncommitted" confirm.

         PROMOTE PANEL (detail, admin):
           package multi-select + name multi-select
           [ ] Merge into system/main
           [ ] Mark for export (pp_sync pull list)
           Never dump whole garden by default.

         UPDATES BADGE (package-updates):
           override where main.updated_at > personal
           → "main newer" + Accept (unoverride) | Keep | Diff

         STORE HELPERS (own-branch, no CTE unless noted):
           count_functions_on_branch
           count_routes_on_branch
           list_own_function_names
           list_overrides (own ∩ parent names)
           lookup_function_on_branch (no CTE)
           delete_function_on_branch (unoverride)

         PHASES:
           A list: ★ current, checkout POST, open, own counts
           B detail: overrides + link /binding/<name>
           C diff vs parent (two pre)
           D fork form + promote panel + unoverride
           E activity / revision log

         NON-GOALS (light):
           git SHAs/commits, PR review UI, blame,
           per-branch data, fancy fork-tree viz
    |))
   )
   (verify
    (build "dune build")
    (smoke "GET /branches shows current ★ and checkout")
    (smoke "POST checkout switches current-branch")
    (smoke "detail lists personal overrides vs main"))
  )
 )
)
