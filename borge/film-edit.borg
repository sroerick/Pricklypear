  (subsection blender-bridge
   (doc "OCaml bridge daemon + bpy socket addon; typed command set; live GUI as view, batch for renders; job queue")
   (status planned)
   (verify
    (smoke "bridge addon loads in headless blender and answers status")
    (smoke "strip-add commands from the daemon build a VSE timeline")
    (smoke "render command produces a playable output file")
    (smoke "one-at-a-time queue: second render waits for first")))

  (subsection prims-http-spawn
   (doc "KERNEL SURFACE: http client prim, spawn subprocess prim, file stat/read-range — additive, general-purpose, gate v2 orchestration")
   (status planned)
   (verify
    (smoke "(http-get url) returns status + body string")
    (smoke "(http-download url path) streams response to disk, returns hash")
    (smoke "(spawn argv) runs a subprocess, captures exit code + output")
    (smoke "prims documented in lisp-interpreter chapter and seeded")
    (details
     (doc (|
        Design notes for the kernel work:
          - http: image currently has only the httpun SERVER side;
            client needs a new small module. Streaming matters: a
            50MB clip must never become a VStr — http-download
            writes to disk and returns the content hash.
          - spawn: argv-array form (no shell), captured stdout/
            stderr, non-zero exit is a value not a crash. Blender,
            ffmpeg, melt are all argv-shaped.
          - Both are useful habitat-wide (agents want curl-from-
            Lisp constantly); they are NOT film-specific and must
            be spec'd as general prims when this subsection
            activates. Auth/capability story: admin-only until
            capability-enforcement (lisp-interpreter) lands.
        |)))))

  (subsection gen-bridge
   (doc "FUTURE EDGE: gen API submission (fal/Replicate/direct), job polling, take landing; expands library bindings into input_snapshot; local ComfyUI as later backend behind same interface")
   (status planned)
   (verify
    (smoke "edit/gen-submit expands cast/refs, writes input_snapshot, creates pending takes")
    (smoke "poller lands done takes with media_hash + cost_cents")
    (smoke "failed jobs mark takes failed with log tail")
    (smoke "spend report sums cost_cents per project and cut")
    (smoke "budget_cents cap blocks submission over budget")
    (smoke "re-gen after asset appearance edit produces a new snapshot, not a silent reuse of the old lock")
    (details
     (doc (|
        Gated on prims-http-spawn. Backend config is rows, not
        code: a backend table (name, base-url, key-ref, model
        menu). Keys live in the credential store pattern already
        used for user LLM keys (auth.user-llm-keys) — never in
        take rows. Local ComfyUI plugs in as backend
        "local-comfy" with the same job protocol when hardware
        arrives; nothing above the backend row changes.

        gen-submit MUST call the same expansion as edit/expand and
        persist input_snapshot + source_assets before the HTTP
        job leaves. Landing a take never mutates the snapshot.
        Changing an asset afterwards does not rewrite old takes;
        only new submits see the new lock (build-system semantics).
        |)))))

  (subsection ui
   (doc "routes /studio, /studio/project?slug=<slug>, /studio/shot, /studio/export: cast/library panel, shot table with take picker, cut timeline view, render state, spend panel. NOTE (2026-10-02): the kernel function editor already owns /edit and /edit/<name>, so the package serves under /studio (BORGE-1785714837).")
   (status planned)
   (verify
    (smoke "GET /studio 200 after load-library")
    (smoke "project page lists assets/cast and shots in ord with chosen takes")
    (smoke "binding a character to a shot shows on the shot row")
    (smoke "choosing a take updates the cut and invalidates render cache visibly")
    (smoke "spend panel shows cost totals per backend")))

  (subsection agent-access
   (doc "pp_eval edit/… as the API; agents drive library, cast, gen, and cut loops")
   (status planned)
   (verify
    (smoke "pp_eval edit/asset-upsert, edit/shot-cast, edit/expand, edit/choose, edit/render work")
    (smoke "an agent can fork a cut branch, retarget cast, swap a take, and render")
    (smoke "an agent can promote a take into a character primary ref")))
 )
)
