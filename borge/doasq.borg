(project pricklypear-doasq
 (doc "doasq — the privileged-request queue on wyo.town (card 257693b2).
   hollis occasionally needs privileged ops: deploys, group changes,
   service restarts. Root stays with roerick; the standing grant is ONE
   doas command (doasq-exec), and every use of it ties to an approved,
   hashed, fully audited request. CLI first (this chapter); the pp
   surface rides on top later.")
 (status partial)
 (convention ksh-openbsd)

 (section model
  (doc "Files under /var/doasq (created by the root bootstrap):
    requests/  hollis-writable  — pending requests (755 hollis)
    approvals/ roerick-writable ONLY (750) — the UNFORGEABLE half:
               hollis can never write here, so hollis can never
               self-approve
    runs/      root-written outputs (755)
    audit.log  root-appended: ts, id, requester, approver, rc, the
               ENTIRE command text
  A request is a small header (id, requester, created, why, sha256)
  followed by --- and the command text verbatim. The sha256 covers
  EVERY byte of the command — quoting exact, multi-line scripts fine —
  so an approval covers exactly what will run, and any later edit is a
  sha mismatch that all three sides (approve, exec, show) refuse.")
  (status implemented)
  (test "approve as hollis refused; exec without approval refused; edited request refused"))

 (section ops
  (doc "doasq submit -w why < cmd   — stdin mode (preferred): the command
    text exactly as typed; argument mode exists but quoting is already
    lost, so nontrivial commands go through stdin. The approver sees the
    why + the FULL command text.
  doasq list / show ID          — the queue, the request, approval state
  doasq approve ID              — roerick only (CLI checks AND dir perms):
    writes approvals/ID.ok {approved-by, approved-at, sha256}
  doasq run ID                  — doas /usr/local/bin/doasq-exec ID
  doasq log [ID]                — audit tail / captured output")
  (status implemented))

 (section runner
  (doc "doasq-exec (root, via the single doas rule — permit nopass hollis
    cmd /usr/local/bin/doasq-exec) verifies BEFORE it runs: request sha
    self-consistency; an approval whose sha matches the command (the
    approval covers EXACTLY the submitted bytes); a one-shot atomic claim
    (mv .ok -> .running) so a second run finds no .ok; then runs
    ksh -c on the text, captures output to runs/ID.out, and appends the
    audit line with the full command. The doas password is not the
    security — the approval gate is; nopass is what makes phone/ssh
    approval flows viable.")
  (status implemented)
  (test "one-shot: second run dies at the claim; audit line carries full text"))

 (section bootstrap
  (doc "ONE root command stands it up (reviewable script,
    /home/hollis/staging/doasq/bootstrap-doasq.ksh): the /var/doasq tree
    with the exact perms, installs the two scripts to /usr/local/bin,
    appends the single doas rule (idempotent, doas.conf backed up
    first), and migrates any staged requests. First queued request:
    R1 20261006T215728-hollis-4f47 — run the deploy hook for master
    (projects face + boot activation).")
  (status implemented))

 (section phase-2
  (doc "The pp surface: the habitat runs on the runtime host and cannot
    touch wyo.town's /var/doasq, so the approval surface is a wyo.town
    httpd CGI behind htpasswd (roerick's credential, unforgeable by
    hollis) — approve/reject per request with the full text rendered,
    phone-friendly; the habitat face links to it. The queue itself stays
    file-based here; the CGI is just another writer to approvals/ with
    the same sha discipline.")
  (status partial))

 (section threat-model
  (doc "hollis cannot self-approve (approvals dir is roerick-only).
    Nothing runs at submission — the queue only writes request files.
    Tampering with a request after approval is a sha mismatch at exec.
    The approval is one-shot and consumed atomically. Every exec is
    audited with the full command text. The doas grant is a single cmd;
    root itself is untouched. Residual risks, accepted for v1: no exec
    timeout (commands should be short; the operator watches), the
    approver reads the command as text (a command can still DO anything
    root can — the queue gates WHO, not WHAT root can do; that is the
    point: every privileged action has a name on it).")
  (status implemented))
 (status partial))
