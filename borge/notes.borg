  (subsection personal-garden
   (doc "Garden notes are personal content — not system/main; path+author isolation")
   (status implemented)
   (* agent note (|2026-08-02: tree_store garden root data.note.u.<user>; notes/garden-root → tree/garden-root; notes/* list scoped via tree index not system/main seed.|) *)
   (verify
    (smoke "notes created while on <user>/personal land under data.note.u.<user>")
    (smoke "notes/* list default scope is current user garden only")
    (smoke "pp-sync snapshot/pull never writes garden note bodies into libs/")
    (smoke "system/main checkout does not seed or clobber garden notes"))
   (details
    (doc (|
         CODE vs CONTENT:
           notes/* roam/* outline/* packages may live on and promote
           to system/main (shared product code).
           Note *bodies*, folders, heading trees, note-link edges for
           the garden MUST NOT be treated as package defaults and MUST
           NOT be seeded from libs/*.

         WHY NOT "data branch" literally (v1):
           branching.data and one-tree placement A keep /data shared
           (no branch_id). Full per-lens versioned data is placement B
           and deferred. Garden isolation v1 is:
             1. path prefix data.note.u.<username>.…
             2. author = session user on write
             3. notes/* list/get/search default to that prefix
             4. never promote note rows via package seed/reseed
         That meets "none of these notes live in main" as product
         content without breaking shared bible/todo data.

         MULTI-USER:
           Alice does not list Bob's data.note.u.bob subtree via the
           default notes UI/API. Admin escape hatches are explicit.

         WORK BRANCH:
           Humans edit garden while checked out on <user>/personal
           (or dev for code spikes). Content path is user-keyed, not
           branch-keyed, so checkout does not hide your notes.
    |))
   )
  )

  (subsection garden-import
   (doc "One-shot Obsidian/markdown vault import into the personal garden tree")
   (status partial)
   (* agent note (|2026-08-02: scripts/import_obsidian_notes.py dry-run+apply, bible:[[…]]→sexp, garden/ folder prefix, collision slugify. Still missing pass-2 uuid note-link reindex after upsert (verify smoke).|) *)
   (verify
    (smoke "dry-run on vault root reports md/folder/link counts; zero writes")
    (smoke "apply imports md under data.note.u.<user>.garden.…")
    (smoke "headings become heading nodes; frontmatter title/org_id kept")
    (smoke "[[wiki]] resolved to uuid edges in pass 2")
    (smoke "[[bible:…]] normalized to (bible …) sexps")
    (smoke "skip EXPORT, .obsidian, tex/pdf/video/aux")
    (smoke "re-import same source_path/org_id updates in place"))
   (details
    (doc (|
         SOURCE (example): /home/roerick/obsidian_vault
         ~227 md files; also tex/pdf/EXPORT/video — not imported.

         SKIP:
           .obsidian/**, EXPORT/**, templates/** (optional later),
           *.{tex,aux,log,pdf,mp4,webm,mov,pyc,png,base}

         ROOT PREFIX:
           data.note.u.<user>.garden.<vault-relative folders…>.<slug>
           Keeps import namespace clear of native PP wiki paths;
           refile later is tree/move.

         DISPLAY:
           The garden/ prefix is an import namespace, not a user-
           facing folder. The /notes index STRIPS a leading garden/
           so imported contents appear at top level as siblings of
           native folders (roam, reading, history as top-level
           folders; no garden bucket in the UI).

         FILE MAP:
           directory          -> folder nodes (title = dir name)
           file.md            -> note leaf
           slug               <- filename stem sanitized [a-z0-9-]+
           title              <- yaml title | first H1 | stem
           source_id          <- yaml org_id if present
           source_path        <- vault-relative path (re-import key)
           tags               <- yaml tags
           kind/day           <- Diary/YYYY-MM-DD.md => daily + day
           # / ## / …         -> heading spine; preamble = root body
           body markdown      -> heading body text (light normalize)

         LINKS (two-pass):
           Pass 1: create folders + notes + headings (no edges).
           Pass 2: scan bodies for [[…]] and bible forms; write
           uuid edges; normalize bible: Obsidian links to sexps.

         SLUG COLLISIONS:
           Global per-user uniqueness. On clash, prefix with parent
           folder label or numeric suffix; report in import log.

         TOOLING:
           Offline importer (OCaml CLI or pp-eval batch driver).
           --dry-run required before apply. Not an image hot path.
           Idempotent on source_id/source_path.

         NON-GOALS:
           Continuous sync, tex pipeline, quartz theme fidelity,
           dataview, round-trip export to the vault.
    |))
   )
  )

  (subsection tree-cutover
   (doc "Phased delivery: kernel tree prims → façade → UUID links → M0 PP migrate → M1 vault")
   (status partial)
   (* agent note (|2026-08-02 confirm: K0–N1/M0/I* largely done (index-read-path implemented). Open: M1 pass-2 links, F finish-cutover slices (legacy light/* residue, heading explode polish, legacy row delete).|) *)
   (implements libs/notes/lib.pp libs/notes/doc/lib.pp image/lib/tree_store.ml libs/tree/lib.pp)
   (verify
    (smoke "K0: tree/get list upsert delete move on folder/note/heading")
    (smoke "K1: tree/get-uuid + slug uniqueness reject")
    (smoke "N0: notes/doc/* round-trip on tree with heading children")
    (smoke "N1: folders via path; no folder string field on write")
    (smoke "R0: uuid note-link + bible sexp render")
    (smoke "M0: existing PP notes migrated; spot-check agents + inbox")
    (smoke "I4: notes/doc/list|row tree-only; no (rows 'note) outside migrate")
    (smoke "GET /notes flat index lists garden/tree-only notes")
    (smoke "tree-browser (tree/render-doc slug root depth fo) walks notes outline")
    (smoke "M1: vault dry-run + apply on personal garden"))
   (details
    (doc (|
         SLICES (one initiative, shippable checkpoints):
           K0  tree prims + readable note path labels
           K1  get-uuid + slug unique constraint/index
           N0  notes façade on tree; outline↔heading (whole-replace ok)
           N1  folders via path; retire folder field writes
           R0  UUID links + bible sexp render via bible/dabar
           M0  migrate data_rows note → tree (same uuids)
           I*  index-read-path (I1–I4): one UI/agent read path through
               notes/doc/* → tree; flat /notes; light/* deleted
           M1  Obsidian md import (garden-import) — still open
           D0  docs: one-tree flag defaults truth; design note appendix

         DEPENDENCY:
           Does NOT wait on global PP_TREE_READS=1 for all CRUD.
           Notes use tree_* prims directly. Flat types keep CRUD.

         STATUS NOTE (post index-read-path I1–I4):
           K0/K1/N0/N1/M0 + I1–I4 are realized. notes/doc/list and
           notes/doc/row are tree-only (no data_rows fallback).
           Legacy type=note rows remain as inert archive; only
           notes/migrate/legacy-* may (rows 'note). /notes routes to
           notes/page → notes/ui/folders-html (flat, budget-safe via
           tree/note-index). notes/list-light aliases index-list.
           Nested notes/tree/render retired (legacy tombstones).
           Remaining for full "implemented": M1 garden-import apply,
           R0 completeness if any bible/roam gaps, D0 docs polish.

         FINISH-CUTOVER (the close-out slices):
           F1  Delete the legacy nested index (notes/light/*) from
               the image so /notes serves ONLY the flat budget-safe
               index over tree/note-index (I1 completion).
           F2  Index groups by PATH-derived folders; a leading
               garden/ strips to top level (garden-import DISPLAY).
           F3  M0 completion: explode every migrated note's inline
               outline blob into real heading child nodes (the Roman
               notes currently render as one blob with a single
               heading); normalize path labels to kebab slug.
           F4  Delete the legacy data_rows type=note rows after F3
               verifies every uuid in the tree (no archive).
           F5  Vault drift: pp-sync the live notes bindings back to
               libs/ so git matches the image before further edits.

         TREE-BROWSER BACKEND SWAPS (content tree contract):
           image.tree-browser v1 walks the CONTENT tree — the notes
           outline model (outline/id title kids) rooted at a note
           slug — NOT tree_nodes paths. Contract that must stay
           stable when storage backends move:
             (tree/render-doc slug root-id depth folders-only?)
               -> html string
             node accessors used by the walker:
               outline/id, outline/title, outline/kids, outline/find
               + notes/doc/get → outline (today notes/doc/outline)
           Swapping outline JSON-in-note for heading nodes under
           data.note.… MUST keep those accessors (or a thin adapter
           with the same names). tree/render itself does not call
           tree/get or rows. Store-tree roots (v2) are a different
           root kind and need lens-aware prims (filed separately).

         RISK:
           Never write hierarchical notes as kind=datum.
           Reverse mirror only handles fn/type/route/datum.
    |))
   )
  )

