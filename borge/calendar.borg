(project pricklypear-calendar
 (doc "Pricklypear book chapter: calendar")
 (status implemented)
 (* agent note (|2026-08-02 status reconcile: sole child model already implemented; libs/calendar/lib.pp ~802 lines; live calendar/today + 27 events; GET /calendar 200.|) *)
 (convention ocaml-dune)
 (section calendar
  
  (doc "Month/day calendar: events + due todos + daily notes")
  (status implemented)
  (subsection model
   (doc "Naive local dates; shared data_rows; Nopales package")
   (status implemented)
   (implements libs/calendar/lib.pp image/lib/primitives.ml)
   (details
    (doc (|
         A calendar should load fast and stay out of the
         way: month grid + day agenda is enough to plan a
         week, and naive local dates keep the model honest
         (no timezone UI pretending to be correct).

         CHOICES (v1):
         - Day click opens day agenda (not auto-create)
         - Naive local YYYY-MM-DD (no TZ UI)
         - Seeded on boot after todo
         - Month + day only (no week view yet)

         DATA: calendar-event
           title day start_time end_time all_day notes
           location color source

         OVERLAYS (read):
           todo-item.due on day
           notes daily-YYYY-MM-DD presence

         PRIMS: date-today date-weekday date-format

         ROUTES: /calendar ?ym= ?day=
         Package: calendar/*
    |))
   )
   (verify
    (smoke "GET /calendar shows month grid")
    (smoke "GET /calendar?day= shows agenda + add form")
    (smoke "create event appears on day"))

  )
 )
)
