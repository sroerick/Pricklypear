(project pricklypear-trees
 (doc "Tree primitives: the storage algebra + contracts for the node forest
   (notes, todos, list rows — everything addressed by path). Draft 2026-10-06
   (hollis), from the 2026-10-05/06 contract-hole inventory. Supersedes the
   implicit contracts of the 107 tree/* prims with a 15-op core + thin rims.
   DECISION (roerick 2026-10-06): the core ops may be OCaml for performance —
   system-wide primitives — but they return SEXP values (the interpreter's
   own AST shapes), never a parallel JSON universe.")
 (status draft)
 (convention ocaml-dune)

 (section model
  (doc "A node is (path, kind, type, body, author, created_at, updated_at,
    hash). The path IS the address. THREE ZONES, one grammar:
      ZONE ::= data.note.u.<user>     ; garden notes (zettelkasten)
             | data.u.<b64-user>      ; garden rows (todos, list items)
             | data.s.<space>         ; shared space rows (the Board)
    Zones are NOT migrated — three deployments of history stay — but ONE
    resolution function resolve-path(path) -> (zone, scope, caller-vis)
    becomes THE visibility chokepoint: enforcement lives in the store rim,
    once, not scattered across 107 prims. [REC roerick Q1: zones stay, the
    wrapper unifies.]")
  (status draft)
  (test "every path in the store parses under the grammar; no path matches two zones"))

 (section contracts
  (doc "Every operation is a TOTAL function: {:ok value} | {:error kind
    reason}, kind in {missing, denied, conflict, too-large, bad-path}.
    Errors are DISTINCT — the empty list never means denied (2026-10-05
    incident: folder-index [] ambiguity burned a dozen probes). All
    listings return {items, next-cursor, truncated, total-hint} — silent
    truncation is retired (incidents: pulse undercounted under the 500
    cap; foreign-cards under the 5000 cap). Depth semantics: depth N =
    N levels below the path, uniformly, in every listing op.")
  (status draft)
  (test "each op: total, distinct error kinds, cursor round-trips, depth uniform"))

 (section core-ops
  (doc "The 15-op core set. Everything else in the 107-prim surface becomes
    sugar over these or is deprecated. Listings return SHALLOW refs (path,
    kind, type, hash) by default — bodies are per-node opt-in
    (with-body #t). Fixes the 268KB-for-89-nodes listing payload.")
  (implements "image/lib/prims_data.ml (rim over store.ml)")
  (status draft)
  (test "each op: total, cursor round-trip, shallow-by-default"))

 (section op-list
  (doc "node-get path -> node | missing | denied
    node-put path kind type body [cas-hash] -> hash        ; CAS optional, phase 2
    node-delete path [recursive] -> ok | missing
    node-exists path -> #t | #f                            ; cheap, indexed
    children path [cursor limit] -> {items, next, truncated} ; depth 1
    subtree path [depth cursor] -> paginated subtree
    find {zone kind type where cursor} -> paginated        ; THE batch query:
      ; where supports list_id IN (...) — retires the N+1 pattern
    count {zone kind type} -> n                            ; indexed count, no scan
    move path new-parent -> new-path                       ; re-parent, cycle-checked
    copy path new-parent -> new-path                       ; deep
    ancestors path -> [node]
    search-text scope query [cursor] -> hits               ; VISIBILITY-ENFORCED
      ; closes BUG 82871ca1 (cross-user read via arbitrary prefixes)
    history path [cursor] -> versions                      ; data-history
    validate path -> diagnostics                           ; integrity checker")
  (status draft))

 (section visibility
  (doc "VIS(zone, scope, caller) -> read? write? — evaluated ONCE per
    operation at the store rim. Garden zones are private to the owner
    (admins pass with attribution). data.s is readable by authenticated
    identities. The find-by prefix opt-out (\"\" = whole store) requires
    the cross-zone-read capability — it is the surface behind BUG
    82871ca1 and is gated here, at the chokepoint, not per-prim.
    [REC roerick Q2: garden-private default + per-zone policy now; the
    private/instance/world tiers from notes.borg defer until a second
    consumer needs them.]")
  (status draft)
  (test "non-owner caller: garden zones deny, shared reads, cross-zone find denies without capability"))

 (section concurrency
  (doc "Phase 2: optimistic CAS per node — node-put carries the expected
    hash; mismatch -> {:error conflict current-hash}. The clobber-family
    bugs and the 027 full-tree hash rehash are the evidence base. v1
    ships last-write-wins with updated_at; CAS is spec'd here so the
    rim reserves the parameter.")
  (status draft))

 (section ocaml-sexp
  (doc "DECISION (roerick 2026-10-06): the core ops are OCaml — Store-layer,
    using the existing indexes — for performance; they are system-wide.
    They return SEXP values (the interpreter's VStr/VList/VDict AST shapes)
    directly into the calling env — no JSON encode/decode round trip in the
    hot path. Lisp-visible shapes match the JSON-dict shapes existing
    callers already consume, so the 107-prim callers keep working while the
    core set replaces their hot paths.")
  (status draft))

 (section large-tree
  (doc "Guarantees at 100k+ nodes (the live store exceeds this):
    children/find/count are INDEXED queries — p95 < 50ms; never a prefix
    scan of the whole forest. The fixture: a synthetic 100k-node generator
    (deterministic seed) runs in the test suite; benchmarks gate the rim.
    Listing payloads shallow-by-default (see core-ops).")
  (status draft)
  (test "100k fixture: children/find/count p95 < 50ms; move/copy correct under iteration"))

 (section process
  (doc "A inventory: all 107 prims -> contract table (solid /
    underspecified / broken), classified against this chapter — driving
    cases are the 2026-10-05/06 incidents. B pure tree_algebra.ml: the
    model + core ops as pure functions over an immutable map, property-
    tested against a naive reference (the branch_algebra pattern, 120+265
    lines). C the rim: prims delegate to the algebra + one visibility
    chokepoint. D fixture + benchmarks.")
  (status draft))
 (status draft))
