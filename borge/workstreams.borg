(project pricklypear-workstreams
 (doc "The orchestration layer: turns the triage board into a managed delivery
  pipeline where each workstream is a list, each card has a status pipeline +
  comment/event thread + acceptance criteria, and the wall-clock work (spec,
  implement, review) is executed by LOCAL agents (laptop pi ralph/subagent loops)
  claiming cards from the habitat. The habitat is the record + queue; the laptop
  is the executor. NO agents run inside the prod image (jobs runner stays for
  small eval jobs). Supersedes the cron-generated static workstreams mirror note
  (2026-09-25: retired — a mirror that reports nothing is worse than no mirror).")
 (status planned)

 ;; ---------------------------------------------------------------------------
 ;; RELATIONSHIPS (what it is / isn't)
 ;; ---------------------------------------------------------------------------
 (section scope
  (doc "Extends borge/work-triage.borg (board + triage-pass + issue-board bridge).
   Adds: PER-WORKSTREAM lists (Basecamp-project shaped; one list = one
   workstream, sharing the same column taxonomy), CARD DETAIL v2 (comments
   thread + transition events interleaved, acceptance criteria, target branch),
   per-column AGENT RECIPES (the instruction template for the work each column
   represents), the CLAIM/BRIEF protocol (how a local pi executor claims a card,
   gets a self-contained brief, works, and writes back a transition + comment),
   the LIVE /workstreams face, and standup v2. Does NOT build an in-image agent
   runtime, does NOT re-spec core todo data model, does NOT touch auth/delegation
   beyond parameter-passing (owner creds or a delegated token).")
  (implements "libs/todo/lib.pp (card detail v2 + recipes)" "libs/standup/lib.pp (v2)"
              "libs/workstreams/lib.pp (face + claim/probe helpers, planned)"
              "scripts/pp-flow.sh (local executor, planned)")
  (status planned))

 ;; ---------------------------------------------------------------------------
 ;; THE DATA MODEL (all Nopales, no kernel changes)
 ;; ---------------------------------------------------------------------------
 (section workstream-lists
  (doc "A workstream is a todo-list with title = stream name (glochid, saguaro,
   town, …) and the shared column taxonomy via its `columns` field (set with
   kanban/columns-set; todo/state/columns-for-list already reads it). The
   shared `Board` list (0b21ffaa) is the cross-stream overview. New intake
   lands in the workstream's TODO column; the triage pass or the owner places
   it.")
  (status implemented-live)  ;; lists created: glochid (fa93a1af), Board (0b21ffaa)
  (verify
   (test "each workstream list carries the same column set as Board"
         "every open board card sits in a named column")))

 (section card-comments
  (doc "Two new datum types, seeded by the todo lib (deftype on load):
   `todo-comment` (fields: item_id, body; author + ts come from the row
   metadata / version history) and `todo-event` (fields: item_id, from_state,
   to_state; auto-written by every state transition via todo/state/next + the
   cycle/move writers). The card detail page interleaves events and comments
   chronologically (Linear-style activity feed). Comments are the ONLY place
   cross-agent context is recorded; transitions are the ONLY signal for
   standup and claim logic.
   STORAGE (2026-09-25): like todo-item itself these datums are USER-scoped in
   the one-tree — node-path resolves data.todo-comment to
   data.u.<user>.todo-comment, and the RLS floor confines reads/writes to the
   caller's user garden. The thread therefore lives under the writing ACCOUNT;
   the claim/brief protocol runs executors under owner creds or a single
   shared executor account (auth/delegation is parameter-passing only, per
   scope), so everyone on a card sees the same feed. All reads/writes go
   through node-path (todo/comment/* — todo/event/* — todo/feed) and
   auto-scope; never hardcode a shared data.<type> path.")
  (implements "libs/todo/lib.pp deftype todo-comment todo-event"
              "libs/todo/lib.pp card detail v2")
  (status implemented-live)  ;; orchestration tasks 2+3 (2026-09-25: comments/events/feed, transition events)
  (verify
   (test "a comment on a card appears on its detail page thread"
         "a state transition appends a todo-event row"
         "feed interleaves events+comments in time order")))

 (section acceptance
  (doc "Each card carries optional `acceptance` (criteria body) and `branch`
   (target branch for the work). These ride the todo-item datum like
   notes/assignee; the brief renders them. Enables 'any agent can pick up a
   card cold' because the card names the deliverable, the target, and the
   done-test.")
  (implements "libs/todo/lib.pp")
  (status implemented-live))  ;; orchestration task 4 (2026-09-25: acceptance + branch fields)

 (section column-recipes
  (doc "The workstream list datum carries a `recipes` field: a dict mapping
   COLUMN NAME -> instruction template (text). E.g. CODE: 'you are the
   implementer for Pricklypear; branch <branch>; implement <title>; acceptance: <acceptance>;
   build with dune; live smoke on <target>; when done move the card to
   LOGIC-REVIEW and comment what you shipped + how reviewed.' A recipe is the
   bridge between the record and the executor — it IS the oracle step boiled
   down to instructions. The brief fn renders card + column recipe + context
   (repo path, branch, host, creds ref) into one self-contained prompt.
   IMPLEMENTED (orchestration task 6, ship 2026-09-27): functions live in the
   todo family as todo/recipes-for-list (the list's EXPLICIT recipes dict as
   an assoc list), todo/recipe (the EFFECTIVE text for one column: explicit
   non-empty recipe else default-family else generic fallback), and
   todo/recipe-set (write one recipe; empty text removes that column's key).
   NAMING NOTE: the build plan originally named these kanban/recipes-for-list
   + kanban/recipe-set + kanban/recipe, but libs/kanban is off-limits to the
   orchestration loop (Do-NOT rule) and master's convention keeps one clean
   namespace per family file — these operate on the todo-list datum, so they
   live in the todo family. The built-in default family (todo/recipes-default)
   covers the shared work-triage taxonomy SPEC / CODE / LOGIC-REVIEW /
   UI-REVIEW / HUMAN-REVIEW / DONE / PARKED / TODO as self-contained
   instruction texts (they reference 'the card above' — the brief prepends
   the card's title/acceptance/branch/state), so every list gets actionable
   instructions before anyone configures a per-list override.")
  (implements "libs/todo/lib.pp (todo/recipes-*)" "libs/todo/lib.pp flow/brief")
  (status implemented-live))  ;; orchestration task 6 (2026-09-27: todo/recipes-* + default family)

 (section claim-brief-protocol
  (doc "THE local executor contract (laptop pi, NOT the image):
   1. CLAIM: the executor (or roerick) sets `assignee` on the card (=claim;
      existing todo/item/assign machinery — landing gregor's assignment work
      provides this on master).
   2. BRIEF: `(todo/flow-brief card-id)` renders the full prompt; for a ralph
      loop the brief IS the plan file; for a subagent it's the task. NAMING
      NOTE: the build plan named this flow/brief; a `libs/flow` package would
      be a NEW family file, and the orchestration loop's Do-NOT rule limits
      it to todo/standup/workstreams libs — so the brief lives in the todo
      family as todo/flow-brief (implemented orchestration task 7).
   3. WORK: the agent reads the brief, does the work on the named branch.
   4. WRITE-BACK: the agent moves the card to the next column
      (todo/state/next-for-list through todo/cycle) and posts a todo-comment
      describing what it did + evidence. A transition to a REVIEW column is
      the 'ready for roerick' signal; the human gate is a real column
      (HUMAN-REVIEW), never an agent.)
   The claim lease is a pid/ts on the assignee field to prevent double-spawn;
   a stale lease (>12h) is reclaimable.")
  (implements "scripts/pp-flow.sh" "libs/todo/lib.pp todo/flow-brief")
  (status implemented-live)  ;; orchestration tasks 7+8 (2026-09-27: todo/flow-brief + scripts/pp-flow.sh)
  (verify
   (test "executor claim → brief contains title+acceptance+column recipe"
         "write-back lands an event + comment and advances exactly one column"
         "stale claims are reclaimable")))

 (section live-face
  (doc "A `/workstreams` route (package workstreams) computed at render time:
   per-workstream column counts (open cards only), 'ready for HUMAN-REVIEW'
   rollup across streams, 'stale' (open >3d) flags, and links into
   /kanban?list=<id> + card detail. Retires the cron 'workstreams' note; the
   note is replaced by a pointer to the live face.")
  (implements libs/workstreams/lib.pp)  ;; ATOM path (not a string) so the lib binds as declared in the book manifest
  (status implemented-live)  ;; orchestration task 9 (2026-09-27: /workstreams live face)
  (verify
   (test "each stream shows live counts matching kanban"
         "HUMAN-REVIEW rollup lists every card in that column across streams")))

 (section standup-v2
  (doc "Extends libs/standup: reads per-workstream counts + the human-review
   rollup + yesterday's transitions (via todo-event rows / data-history), so
   gregor's 09:00 brief says 'here's where each stream is, here's what moved,
   here's what's ready for you' — from the live store, not a static mirror.")
  (implements "libs/standup/lib.pp v2")
  (status implemented-live))  ;; orchestration task 10 (2026-09-27: per-stream counts + review rollup + moved-yesterday, guarded)

 (section landing-gregors-assignment-work
  (doc "Requires porting 0f1b9a4+b7059e6+133b228+89e5ddf (assignment/priority/
   queue // make-card,move-card,stale // /kanban-review) into master's SINGLE
   libs/todo/lib.pp (master is one lib.pp per package family, 4a17395; the
   item/lib.pp split from the orphaned todo-assignment branch does NOT match
   master's layout and is not merged). Carry the functions, not the file
   layout. Provides assignee (claim) + priority (queue) that this chapter's
   protocol depends on.")
  ;; orchestration task 1 (2026-09-27: 286360d; kanban half already merged in libs/kanban)
  (status implemented-live))
)